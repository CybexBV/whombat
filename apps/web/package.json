    "@tanstack/react-router": "^1.170.38",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-collaboration": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/y-tiptap": "^3.0.9",
    "@whombat/avatars": "workspace:*",
    "@whombat/brand": "workspace:*",
    "@whombat/canvas-schema": "workspace:*",
    "@whombat/client": "workspace:*",
    "@whombat/control-contracts": "workspace:*",
    "@whombat/core": "workspace:*",
    "@whombat/fixtures": "workspace:*",
    "@whombat/protocol": "workspace:*",
    "@whombat/screen": "workspace:*",
    "@whombat/secure-channel": "workspace:*",
    "@whombat/tokens": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "lib0": "^0.2.117",
    "lucide-react": "^1.47.0",
