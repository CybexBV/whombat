{
  "name": "@whombat/web",
  "license": "AGPL-3.0-only",
  "version": "3.151.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "VITE_FIXTURES=1 vite",
    "build": "vite build",
    "build:prod": "UV_THREADPOOL_SIZE=16 VITE_FIXTURES= VITE_WHOMBAT_TARGET=box vite build --mode production",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "visual": "playwright test --project=visual --pass-with-no-tests",
    "storybook": "storybook dev -p ${STORYBOOK_PORT:-6006} --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "e2e:managed": "playwright test --project=managed",
    "build:hosted": "VITE_FIXTURES= VITE_WHOMBAT_TARGET=hosted vite build --mode production --outDir dist-hosted",
    "e2e:hosted": "playwright test --project=hosted",
    "e2e:box": "playwright test --project=box",
    "e2e:runtime": "playwright test --project=runtime",
    "readme:shots": "README_SHOTS=${README_SHOTS:-docs/readme} playwright test --project=readme"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
