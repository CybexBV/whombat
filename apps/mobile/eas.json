{
  "cli": { "version": ">= 24.4.2", "appVersionSource": "local" },
  "build": {
    "development": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": false,
      "ios": { "autoIncrement": false, "buildConfiguration": "Release" }
    },
    "ios-simulator": {
      "extends": "preview",
      "node": "24.18.0",
      "pnpm": "12.3.4",
      "ios": { "simulator": true, "buildConfiguration": "Release" }
    }
  }
}
