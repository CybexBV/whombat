<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Debug builds only: inject a push payload with adb (see DebugPushReceiver). -->
    <receiver
      android:name="com.whombat.live.DebugPushReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="com.whombat.live.DEBUG_PUSH" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
