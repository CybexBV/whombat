<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Android 16 Live Updates: ongoing notifications promoted to the status bar chip and the top of the shade. -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

  <!-- Whether this phone has a Live Updates settings page for the app (Settings → Notifications names it only then). -->
  <queries>
    <intent>
      <action android:name="android.settings.APP_NOTIFICATION_PROMOTION_SETTINGS" />
    </intent>
  </queries>

  <application>
    <!--
      Receives Whombat's FCM data messages (live activities and inbox notifications) whether or not the app
      is running. Priority 1 wins over expo-notifications' own service (-1), which only fetches the token.
    -->
    <service
      android:name="com.whombat.live.WhombatMessagingService"
      android:exported="false">
      <intent-filter android:priority="1">
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>

    <!-- Home-screen status widget: displays the last status saved by the app and opens the app on tap. -->
    <receiver
      android:name="com.whombat.live.WhombatStatusWidgetProvider"
      android:label="@string/whombat_widget_label"
      android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/whombat_status_widget_info" />
    </receiver>
  </application>
</manifest>
