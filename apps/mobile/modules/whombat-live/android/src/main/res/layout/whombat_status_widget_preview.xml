<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/whombat_widget_bg">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

      <ImageView
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:importantForAccessibility="no"
          android:src="@drawable/whombat_widget_logo" />

      <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:layout_weight="1"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:maxLines="1"
          android:text="@string/whombat_widget_preview_box"
          android:textColor="@color/whombat_widget_mut"
          android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

      <ImageView
          android:layout_width="9dp"
          android:layout_height="9dp"
          android:layout_marginEnd="7dp"
          android:importantForAccessibility="no"
          android:src="@drawable/whombat_widget_dot_ok" />

      <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:maxLines="2"
          android:text="@string/whombat_widget_preview_status"
          android:textColor="@color/whombat_widget_ink"
          android:textSize="16sp"
          android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/whombat_widget_preview_as_of"
        android:textColor="@color/whombat_widget_mut"
        android:textSize="12sp"
        android:typeface="monospace" />
  </LinearLayout>
</FrameLayout>
