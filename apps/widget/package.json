{
  "name": "@whombat/widget",
  "license": "AGPL-3.0-only",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Whombat Feedback: the embeddable loader and the reporting frame (docs/decisions/feedback.md).",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:embed": "tsx scripts/build.ts --embed",
    "dev": "tsx scripts/build.ts --watch",
    "e2e": "tsx e2e/run.ts",
    "e2e:drop": "tsx e2e/drop.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:real": "tsx e2e/real/run.ts"
  },
  "dependencies": {
    "@whombat/core": "workspace:*",
    "@whombat/tokens": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^26.6.2",
    "@whombat/control-contracts": "workspace:*",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
