# One assistant runner per hub connection (rackoon-assist.socket): it
# installs and updates Claude Code and Codex, keeps their sign-ins and
# session files in /var/lib/rackoon-assist, and runs investigations
# (docs/ASSIST.md). Proxy settings for the CLIs (HTTPS_PROXY, NO_PROXY,
# SSL_CERT_FILE) go in /etc/rackoon/assist.env.
[Unit]
Description=Rackoon assistant runner
CollectMode=inactive-or-failed

[Service]
Type=simple
ExecStart=/usr/local/bin/rackoon-hub assist serve --state /var/lib/rackoon-assist
StandardInput=socket
StandardOutput=socket
StandardError=journal
Environment=RACKOON_ASSIST_SANDBOX=1
EnvironmentFile=-/etc/rackoon/assist.env
# The CLIs it started end with it.
KillMode=control-group
TimeoutStopSec=15s

DynamicUser=yes
User=rackoon-assist
StateDirectory=rackoon-assist
StateDirectoryMode=0700
UMask=0077

# Sandbox. Not MemoryDenyWriteExecute: Claude Code's JavaScript runtime
# compiles code at run time. Not RestrictNamespaces: Codex sandboxes its own
# helpers with namespaces.
InaccessiblePaths=-/var/lib/private/rackoon -/var/lib/rackoon -/etc/rackoon
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=4G
TasksMax=1024
LimitNOFILE=65536
