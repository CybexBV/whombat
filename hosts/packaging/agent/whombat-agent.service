[Unit]
Description=Whombat agent (host metrics, inventory, guest consoles)
Wants=network-online.target
After=network-online.target
# Not enrolled yet: run `whombat-agent enroll ...` first (install.sh does).
ConditionPathExists=/etc/whombat-agent/agent.toml

[Service]
Type=exec
ExecStart=/usr/bin/whombat-agent run --config-dir /etc/whombat-agent
# Re-reads [remote_control] from agent.toml.
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5s
TimeoutStopSec=20s
# SIGTERM to the agent; helpers it started (PTY consoles) are killed after.
KillMode=mixed

# The agent runs as root: it reads SMART data and talks to the Docker, Incus,
# libvirt and Proxmox VE (QMP, qm/pct) interfaces, which are root-only. The
# sandbox below keeps the file system read-only except for its own
# configuration (certificate renewal) and state (sample buffer). On Proxmox
# VE, guest starts and container shells run in transient units (systemd-run)
# so they do not inherit this sandbox.
StateDirectory=whombat-agent
StateDirectoryMode=0700
ReadWritePaths=/etc/whombat-agent
# The PVE collector may create its read-only API token (pveum) on first run.
ReadWritePaths=-/etc/pve
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# No changing the system clock or the RTC. (Not ProtectClock=yes: its system
# call filter also blocks the read-only adjtimex() the agent uses to report
# whether the clock is synchronized.)
CapabilityBoundingSet=~CAP_SYS_TIME CAP_WAKE_ALARM
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# SMART needs the raw disk devices; serial consoles need /dev/pts.
PrivateDevices=no
LimitNOFILE=65536

# Resource limits. A healthy agent uses ~30-50 MB and well under 1% of one
# core (helpers such as smartctl and apt-get -s included); the limits only
# bite when something goes wrong, and the agent yields to real workloads.
MemoryHigh=256M
MemoryMax=512M
TasksMax=512
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=50

[Install]
WantedBy=multi-user.target
