#!/sbin/openrc-run
description="Whombat agent (server monitoring)"
command="/usr/local/bin/whombat-agent"
command_args="run --config-dir /etc/whombat-agent"
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=0
umask=0077
stopgroup=yes
retry="SIGTERM/20/SIGKILL/5"
output_logger="logger -t whombat-agent"
error_logger="logger -t whombat-agent"

depend() {
    need net
    after firewall
}

start_pre() {
    checkpath --directory --mode 0700 /var/lib/whombat-agent
    [ -r /etc/whombat-agent/agent.toml ] || { eerror "Enroll the Whombat agent first."; return 1; }
}
