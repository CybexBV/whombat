<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
<!ENTITY name      "lcd_manager">
<!ENTITY author    "SimonFair">
<!ENTITY version   "2024.11.23">
<!ENTITY launch    "LCDSettings">
<!ENTITY gitURL    "https://raw.githubusercontent.com/SimonFair/unraid-lcd/master">
<!ENTITY pluginURL "&gitURL;/lcd_manager.plg">
<!ENTITY supportURL	"https://forums.unraid.net/topic/136952-plugin-lcd_manager/">
<!ENTITY packages	"/boot/config/plugins/&name;/packages">
<!ENTITY plgPATH   "/boot/config/plugins/&name;">
<!ENTITY md5		"fc9c1404069bbbf1f41526d518e511e7">
]>

<PLUGIN name="&name;"
		author="&author;"
		launch="&launch;"
		version="&version;"
		pluginURL="&pluginURL;"
		support="&supportURL;"
		icon="lcd.png"
		min="6.8.0">
<!-- The rest of the file (CHANGES, FILE elements) is left out: the agent reads the head only. -->
</PLUGIN>
