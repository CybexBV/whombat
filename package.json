{
  "name": "whombat",
  "license": "AGPL-3.0-only",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "concurrently --group --kill-others-on-fail --names lint,notices,types,tests \"biome check --error-on-warnings . && bash scripts/check-forbidden.sh\" \"pnpm notices --check\" \"pnpm typecheck\" \"pnpm test\"",
    "ci:check": "python3 scripts/ci/check.py run",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tsconfig.json",
    "lint": "biome check --error-on-warnings . && bash scripts/check-forbidden.sh",
    "format": "biome check --write .",
    "dev": "node --import tsx scripts/dev.ts",
    "dev:web": "concurrently -k -n web,widget -c magenta,yellow \"pnpm --filter @whombat/web dev\" \"pnpm --filter @whombat/widget dev\"",
    "dev:ask": "pnpm --filter @whombat/server dev:ask",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "pnpm --filter @whombat/server test:int",
    "test:cli": "pnpm --filter @whombat/cli test:int",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "hermes:test": "python3 packages/hermes-whombat/scripts/test.py",
    "whombat": "node --import tsx apps/cli/src/bin.ts",
    "soak:managed": "pnpm --filter @whombat/server soak:managed",
    "db:migrate": "pnpm --filter @whombat/server db:migrate",
    "db:reset": "pnpm --filter @whombat/server db:reset",
    "db:seed": "pnpm --filter @whombat/server db:seed",
    "demo:play": "pnpm --filter @whombat/server demo play",
    "demo:reset": "pnpm --filter @whombat/server demo reset",
    "bundle:runtime": "pnpm --filter @whombat/package bundle:runtime",
    "hermes:install": "node --import tsx scripts/hermes-install.ts",
    "assistant-settings:gen": "node --import tsx scripts/assistant-settings-gen.ts",
    "hermes:e2e": "node --import tsx packages/agent-runtime/scripts/hermes-e2e.ts",
    "hermes:pod-e2e": "node --import tsx apps/runner/scripts/pod-e2e.ts",
    "build:web": "pnpm --filter @whombat/web build:prod",
    "build:web:hosted": "pnpm --filter @whombat/web build:hosted",
    "build:widget": "pnpm --filter @whombat/widget build",
    "build:embed": "pnpm --filter @whombat/widget build:embed",
    "e2e:managed": "pnpm --filter @whombat/web e2e:managed",
    "e2e:box": "pnpm --filter @whombat/web e2e:box",
    "visual": "pnpm --filter @whombat/web visual",
    "ref:shot": "tsx tools/visual/src/shot.ts",
    "visual:diff": "tsx tools/visual/src/diff.ts",
    "app:release": "tsx scripts/app/release-dist.ts",
    "contracts:release": "tsx contracts/scripts/release.ts",
    "contracts:gen": "tsx contracts/conformance/src/gen-cross-language.ts",
    "contracts:gen:check": "pnpm contracts:gen && git diff --exit-code -- contracts/schema contracts/vectors contracts/go && test -z \"$(git status --porcelain -- contracts/schema contracts/vectors contracts/go)\"",
    "contracts:test:go": "cd contracts/go && go vet ./... && go test ./...",
    "notices": "tsx scripts/third-party-notices.ts",
    "decision-ids": "tsx scripts/decision-ids/ids.ts",
    "e2e:runtime": "pnpm --filter @whombat/web e2e:runtime",
    "readme:shots": "pnpm --filter @whombat/web readme:shots"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
