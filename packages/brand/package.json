{
  "name": "@whombat/brand",
  "license": "AGPL-3.0-only",
  "version": "4.15.0",
  "private": true,
  "type": "module",
  "description": "The Whombat logo, its marks and the files made from them (SVG trees, a React renderer).",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./files": "./src/files.ts",
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "./files": {
        "types": "./dist/files.d.ts",
        "default": "./dist/files.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export-icons": "tsx scripts/export-icons.ts",
    "export-marks": "tsx scripts/export-marks.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@whombat/core": "workspace:*",
    "@whombat/tokens": "workspace:*",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
