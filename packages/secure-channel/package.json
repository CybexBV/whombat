{
  "name": "@whombat/secure-channel",
  "license": "AGPL-3.0-only",
  "version": "4.15.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "End-to-end Noise (libp2p-noise XX) session over an injected byte stream. Pure: no Node-only APIs except in ./node.",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:docker": "docker run --rm --network host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -e TMPDIR=/tmp -v \"$(cd ../.. && pwd)\":\"$(cd ../.. && pwd)\" -w \"$PWD\" mcr.microsoft.com/playwright:v1.63.0-noble npx vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@libp2p/crypto": "5.1.23",
    "@libp2p/interface": "3.3.0",
    "@libp2p/noise": "17.0.3",
    "@libp2p/peer-id": "6.0.15",
    "@libp2p/utils": "7.4.1",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "uint8arraylist": "3.0.2"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "@whombat/core": "workspace:*",
    "@whombat/protocol": "workspace:*",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "ws": "8.21.3"
  }
}
