{
  "name": "@whombat/tokens",
  "license": "AGPL-3.0-only",
  "version": "4.13.0",
  "private": true,
  "type": "module",
  "description": "The design tokens: colors, type, spacing, radii, shadows and the faces, for web (tokens.css) and React Native.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./tokens.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "tokens.css"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./tokens.css": "./tokens.css"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "tsx scripts/generate-css.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@whombat/core": "workspace:*"
  }
}
