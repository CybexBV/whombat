{
  "name": "@whombat/protocol",
  "license": "AGPL-3.0-only",
  "version": "4.16.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Relay protocol v1, admission tickets, the appliance licence, the claim ceremony (claim code, CPace), session protocol v1 (frames, messages, operations, enrollment).",
  "exports": {
    ".": "./src/index.ts",
    "./relay": "./src/relay.ts",
    "./direct": "./src/direct.ts",
    "./admission": "./src/admission.ts",
    "./licence": "./src/licence.ts",
    "./claim": "./src/claim/index.ts",
    "./frame": "./src/frame.ts",
    "./session": "./src/session/index.ts",
    "./collab": "./src/collab.ts",
    "./console": "./src/console.ts",
    "./own-address": "./src/own-address.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./relay": {
        "types": "./dist/relay.d.ts",
        "default": "./dist/relay.js"
      },
      "./direct": {
        "types": "./dist/direct.d.ts",
        "default": "./dist/direct.js"
      },
      "./admission": {
        "types": "./dist/admission.d.ts",
        "default": "./dist/admission.js"
      },
      "./licence": {
        "types": "./dist/licence.d.ts",
        "default": "./dist/licence.js"
      },
      "./claim": {
        "types": "./dist/claim/index.d.ts",
        "default": "./dist/claim/index.js"
      },
      "./frame": {
        "types": "./dist/frame.d.ts",
        "default": "./dist/frame.js"
      },
      "./session": {
        "types": "./dist/session/index.d.ts",
        "default": "./dist/session/index.js"
      },
      "./collab": {
        "types": "./dist/collab.d.ts",
        "default": "./dist/collab.js"
      },
      "./console": {
        "types": "./dist/console.d.ts",
        "default": "./dist/console.js"
      },
      "./own-address": {
        "types": "./dist/own-address.d.ts",
        "default": "./dist/own-address.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@whombat/core": "workspace:*",
    "@whombat/release": "workspace:*",
    "zod": "^4.6.5"
  }
}
