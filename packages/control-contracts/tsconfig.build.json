{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "paths": {
      "@whombat/core": ["../core/dist/index.d.ts"],
      "@whombat/core/*": ["../core/dist/*/index.d.ts", "../core/dist/*.d.ts"],
      "@whombat/protocol": ["../protocol/dist/index.d.ts"],
      "@whombat/protocol/*": ["../protocol/dist/*/index.d.ts", "../protocol/dist/*.d.ts"],
      "@whombat/release": ["../release/dist/index.d.ts"],
      "@whombat/release/*": ["../release/dist/*/index.d.ts", "../release/dist/*.d.ts"]
    },
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/__fixtures__/**"]
}
