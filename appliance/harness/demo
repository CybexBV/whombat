#!/usr/bin/env bash
# harness/demo — scripted acceptance demonstration of slice B (docs/runbooks/acceptance.md).
#   harness/demo [--live [app,runtime,…]] [--reuse] [vitest args, e.g. -t "part 2"]
#     --live [list]  run all (or the listed) components from their owners' working trees, the rest pinned;
#                    the client comes from the live whombat-app when the app is live
#     --reuse  don't reset the environment (part 1 needs an unclaimed appliance)
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export TMPDIR="${TMPDIR:-$HOME/.cache/wb-tmp}"; mkdir -p "$TMPDIR"
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --live)
      if [ $# -gt 1 ] && [[ "$2" != -* ]]; then export WB_DEMO_LIVE="$2"; shift; else export WB_DEMO_LIVE=all; fi ;;
    --reuse) export WB_DEMO_REUSE=1 ;;
    *) args+=("$1") ;;
  esac
  shift
done
[ -d "$here/node_modules" ] || (cd "$here" && pnpm install --frozen-lockfile >&2)
cd "$here" && exec pnpm exec vitest run --config vitest.demo.config.ts --reporter=verbose "${args[@]}"
