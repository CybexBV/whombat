#!/usr/bin/env bash
# manifest/build — see docs/runbooks/local-dev.md. Implementation: harness/src/manifest/build.ts.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export TMPDIR="${TMPDIR:-$HOME/.cache/wb-tmp}"; mkdir -p "$TMPDIR"
[ -d "$here/../harness/node_modules" ] || (cd "$here/../harness" && pnpm install --frozen-lockfile >&2)
exec node "$here/../harness/src/manifest/build.ts" "$@"
