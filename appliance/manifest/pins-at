#!/usr/bin/env bash
# manifest/pins-at — the pins of a commit of this repository, from the component list (manifest/components.json).
# Implementation: harness/src/manifest/components.ts.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export TMPDIR="${TMPDIR:-$HOME/.cache/wb-tmp}"; mkdir -p "$TMPDIR"
[ -d "$here/../harness/node_modules" ] || (cd "$here/../harness" && pnpm install --frozen-lockfile >&2)
exec node "$here/../harness/src/manifest/components.ts" "$@"
