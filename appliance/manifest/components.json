{
  "$schema": "whombat.components/1",
  "components": [
    {
      "id": "whombat-contracts",
      "repository": "Whombat",
      "in": "whombat",
      "versionFrom": "packages/core/package.json",
      "build": [
        {
          "run": [
            "pnpm",
            "install",
            "--frozen-lockfile"
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 1800
        },
        {
          "run": [
            "pnpm",
            "contracts:release",
            "--skip-check",
            "--rebuild"
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 1800
        }
      ],
      "artifacts": [
        {
          "name": "whombat-contracts",
          "kind": "tarball",
          "from": {
            "type": "sums",
            "path": "dist-release/contracts/{contracts}/SHA256SUMS",
            "compareWith": "{whombat}/dist-release/contracts/{contracts}/SHA256SUMS"
          },
          "note": "rebuilt from the commit in a clean clone and compared with the published release control and the relay vendor; they differ when the contracts changed since that release"
        }
      ],
      "gates": [
        {
          "run": [
            "pnpm",
            "contracts:test:go"
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 900,
          "id": "go-test",
          "needsPostgres": false
        },
        {
          "run": [
            "pnpm",
            "contracts:gen:check"
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 900,
          "id": "gen-check",
          "needsPostgres": false
        }
      ],
      "notes": []
    },
    {
      "id": "whombat-relay",
      "repository": "whombat-relay",
      "in": "cloud",
      "dir": "relay",
      "version": "0.0.0-dev",
      "build": [
        {
          "run": [
            "make",
            "build"
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 900
        }
      ],
      "artifacts": [
        {
          "name": "whombat-relay/bin",
          "kind": "tarball",
          "from": {
            "type": "tar",
            "cwd": "bin",
            "paths": [
              "relay",
              "relay-loadgen",
              "dev-ticket"
            ]
          },
          "note": "static CGO_ENABLED=0 -trimpath binaries; version stamped from git describe"
        },
        {
          "name": "whombat-relay/source",
          "kind": "tarball",
          "from": {
            "type": "git-archive",
            "prefix": "whombat-relay/"
          }
        }
      ],
      "gates": [
        {
          "run": [
            "make",
            "test"
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 1800,
          "id": "test",
          "needsPostgres": false
        },
        {
          "run": [
            "make",
            "lint"
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 900,
          "id": "lint",
          "needsPostgres": false
        }
      ],
      "notes": []
    },
    {
      "id": "whombat-api",
      "repository": "whombat-api",
      "in": "cloud",
      "dir": "control",
      "version": "0.1.0",
      "build": [
        {
          "run": [
            "pnpm",
            "install",
            "--frozen-lockfile"
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 1800
        },
        {
          "run": [
            "bash",
            "-c",
            "cd vendor/whombat-contracts/* && sha256sum -c SHA256SUMS"
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 1800
        },
        {
          "run": [
            "pnpm",
            "typecheck"
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 900
        }
      ],
      "artifacts": [
        {
          "name": "whombat-api/source",
          "kind": "tarball",
          "from": {
            "type": "git-archive",
            "prefix": "whombat-api/"
          },
          "note": "control runs from source on Node 24 (type stripping); the OCI image is built by its infra, not here"
        }
      ],
      "gates": [
        {
          "run": [
            "pnpm",
            "check"
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 1800,
          "id": "check",
          "needsPostgres": false
        },
        {
          "run": [
            "pnpm",
            "test:int"
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 1800,
          "id": "test-int",
          "needsPostgres": true
        }
      ],
      "notes": []
    },
    {
      "id": "whombat-runtime",
      "repository": "Whombat",
      "in": "whombat",
      "versionFrom": "package.json",
      "build": [
        {
          "run": [
            "pnpm",
            "install",
            "--frozen-lockfile"
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 1800
        }
      ],
      "artifacts": [
        {
          "name": "whombat-runtime/source",
          "kind": "tarball",
          "from": {
            "type": "git-archive",
            "prefix": "whombat/"
          },
          "note": "the repository’s source at the commit; the runtime the image ships is built by Nix (release/build), not here"
        },
        {
          "name": "whombat-runtime/compat.json",
          "kind": "tarball",
          "from": {
            "type": "file",
            "path": "apps/server/src/db/migrations/compat.json"
          }
        }
      ],
      "gates": [
        {
          "run": [
            "pnpm",
            "check"
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 2400,
          "id": "check",
          "needsPostgres": false
        },
        {
          "run": [
            "pnpm",
            "test:server"
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 3600,
          "id": "test-server",
          "needsPostgres": true
        }
      ],
      "notes": []
    },
    {
      "id": "whombat-app",
      "repository": "Whombat",
      "in": "whombat",
      "versionFrom": "apps/web/package.json",
      "build": [
        {
          "run": [
            "pnpm",
            "install",
            "--frozen-lockfile"
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 1800
        },
        {
          "run": [
            "pnpm",
            "--filter",
            "@whombat/web",
            "build:hosted"
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 1200
        },
        {
          "run": [
            "pnpm",
            "build:embed",
            "--control-url",
            "https://api.whombat.com"
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 900
        }
      ],
      "artifacts": [
        {
          "name": "whombat-app/web-hosted",
          "kind": "web-bundle",
          "from": {
            "type": "tar",
            "cwd": "apps/web/dist-hosted",
            "paths": [
              "."
            ]
          },
          "note": "hosted UI, VITE_WHOMBAT_TRANSPORT=session, production mode"
        },
        {
          "name": "whombat-app/embed",
          "kind": "web-bundle",
          "from": {
            "type": "tar",
            "cwd": "apps/widget/dist-embed",
            "paths": [
              "."
            ]
          },
          "note": "the Feedback widget’s embed tree for production’s control (https://api.whombat.com); each deployment builds its own with its control URL (the harness does)"
        },
        {
          "name": "whombat-app/source",
          "kind": "tarball",
          "from": {
            "type": "git-archive",
            "prefix": "whombat-app/"
          }
        }
      ],
      "gates": [],
      "notes": []
    },
    {
      "id": "appliance-manager",
      "repository": "whombat-appliance",
      "in": "whombat",
      "dir": "appliance",
      "version": "0.0.0-dev",
      "build": [
        {
          "run": [
            "go",
            "build",
            "-trimpath",
            "-o",
            "bin/",
            "./manager/cmd/...",
            "./helper/cmd/...",
            "./release-tools/cmd/..."
          ],
          "cwd": ".",
          "env": {
            "CGO_ENABLED": "0"
          },
          "timeoutS": 900
        }
      ],
      "artifacts": [
        {
          "name": "whombat-manager/bin",
          "kind": "tarball",
          "from": {
            "type": "tar",
            "cwd": "bin",
            "paths": [
              "whombat-manager",
              "whombat-manager-recovery",
              "whombat-update-helper",
              "tufrepo"
            ]
          }
        }
      ],
      "gates": [
        {
          "run": [
            "go",
            "vet",
            "./..."
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 900,
          "id": "go-vet",
          "needsPostgres": false
        },
        {
          "run": [
            "go",
            "test",
            "-count=1",
            "./..."
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 1800,
          "id": "go-test",
          "needsPostgres": false
        }
      ],
      "notes": []
    },
    {
      "id": "appliance-backup",
      "repository": "whombat-appliance",
      "in": "whombat",
      "dir": "appliance",
      "version": "0.0.0-dev",
      "build": [
        {
          "run": [
            "go",
            "build",
            "-trimpath",
            "-o",
            "../bin/",
            "./cmd/..."
          ],
          "cwd": "backup",
          "env": {
            "CGO_ENABLED": "0"
          },
          "timeoutS": 900
        }
      ],
      "artifacts": [
        {
          "name": "whombat-backup/bin",
          "kind": "tarball",
          "from": {
            "type": "tar",
            "cwd": "bin",
            "paths": [
              "whombat-backup",
              "whombat-backup-snapd"
            ]
          }
        }
      ],
      "gates": [
        {
          "run": [
            "go",
            "vet",
            "./..."
          ],
          "cwd": "backup",
          "env": {},
          "timeoutS": 900,
          "id": "go-vet",
          "needsPostgres": false
        },
        {
          "run": [
            "go",
            "test",
            "-count=1",
            "./..."
          ],
          "cwd": "backup",
          "env": {},
          "timeoutS": 1800,
          "id": "go-test",
          "needsPostgres": false
        }
      ],
      "notes": []
    },
    {
      "id": "appliance-provisioning",
      "repository": "whombat-appliance",
      "in": "whombat",
      "dir": "appliance",
      "version": "0.0.0-dev",
      "build": [
        {
          "run": [
            "go",
            "build",
            "-trimpath",
            "-o",
            "../bin/",
            "./cmd/..."
          ],
          "cwd": "provisioning",
          "env": {
            "CGO_ENABLED": "0"
          },
          "timeoutS": 900
        }
      ],
      "artifacts": [
        {
          "name": "whombat-provision/bin",
          "kind": "tarball",
          "from": {
            "type": "tar",
            "cwd": "bin",
            "paths": [
              "whombat-provision",
              "whombat-fake-control"
            ]
          }
        }
      ],
      "gates": [
        {
          "run": [
            "go",
            "test",
            "-count=1",
            "./..."
          ],
          "cwd": "provisioning",
          "env": {},
          "timeoutS": 1800,
          "id": "go-test",
          "needsPostgres": false
        }
      ],
      "notes": [
        "the NixOS flake, image and VM tests (nixos branch, merged into appliance main) are qualified by W2-NX (vm-tests/), not by this harness"
      ]
    },
    {
      "id": "whombat-hosts",
      "repository": "whombat-hosts",
      "in": "whombat",
      "dir": "hosts",
      "version": "0.0.0-dev",
      "build": [
        {
          "run": [
            "go",
            "build",
            "-trimpath",
            "-o",
            "bin/",
            "./cmd/whombat-hosts",
            "./cmd/whombat-agent"
          ],
          "cwd": ".",
          "env": {
            "CGO_ENABLED": "0"
          },
          "timeoutS": 900
        }
      ],
      "artifacts": [
        {
          "name": "whombat-hosts/bin",
          "kind": "tarball",
          "from": {
            "type": "tar",
            "cwd": "bin",
            "paths": [
              "whombat-hosts",
              "whombat-agent"
            ]
          },
          "note": "the hub and the agent for this machine; the image builds both agents (amd64, arm64) from hosts/ of the same commit"
        },
        {
          "name": "whombat-hosts/source",
          "kind": "tarball",
          "from": {
            "type": "git-archive",
            "prefix": "whombat-hosts/"
          }
        }
      ],
      "gates": [
        {
          "run": [
            "go",
            "vet",
            "./..."
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 900,
          "id": "go-vet",
          "needsPostgres": false
        },
        {
          "run": [
            "go",
            "test",
            "-count=1",
            "./..."
          ],
          "cwd": ".",
          "env": {},
          "timeoutS": 1800,
          "id": "go-test",
          "needsPostgres": false
        }
      ],
      "notes": [
        "the hosts service: the image’s whombat-hosts.service and the dev stack’s hosts service"
      ]
    }
  ],
  "tuple": {
    "hostAbi": 1,
    "runtimeHostAbi": {
      "min": 1,
      "max": 1
    },
    "providers": [
      {
        "provider": "scripted",
        "version": "0.0.0-dev",
        "placeholder": true,
        "note": "the deterministic ScriptedProvider ships inside the runtime; no separate bundle exists"
      },
      {
        "provider": "codex",
        "version": "0.0.0-placeholder",
        "placeholder": true,
        "note": "pinned official Codex bundle not built yet (W3-PV)"
      },
      {
        "provider": "claude",
        "version": "0.0.0-placeholder",
        "placeholder": true,
        "note": "pinned official Claude Code bundle not built yet (W3-PV)"
      }
    ]
  },
  "placeholders": [
    {
      "path": "tuple.runtime.storePath, tuple.runtime.narHash",
      "reason": "the runtime Nix closure is not built yet; storePath is a deterministic fake and narHash is the source tarball digest",
      "owner": "W2-NX / W2-RT"
    },
    {
      "path": "tuple.providers[*]",
      "reason": "provider bundles are not built yet; identities are placeholders",
      "owner": "W3-PV"
    },
    {
      "path": "tuple.host, tuple.manager",
      "reason": "no NixOS system generation or manager closure is built by the harness; storePath is a deterministic fake, narHash the binary tarball digest (manager) or a fake (host)",
      "owner": "W2-NX / W1-MG"
    },
    {
      "path": "tuple.runtime.hostAbi, tuple.host.abi",
      "reason": "host ABI levels are not defined yet; 1 is a placeholder",
      "owner": "W2-NX"
    },
    {
      "path": "upgradePaths",
      "reason": "no earlier managed release exists; the legacy self-hosted import is a migration tool, not a device upgrade path",
      "owner": "orchestrator"
    }
  ]
}
