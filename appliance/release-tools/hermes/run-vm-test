#!/usr/bin/env bash
# run-vm-test <driver> <log>: one NixOS VM test driver (`.#checks.<system>.<test>.driver`), run by the latest-tested
# Hermes job inside `agent-resource run` (NX-485): QEMU stays in that task's cgroup and its disks in the task's own
# workspace, which agent-resource removes afterwards. As scripts/ci/virtual-machines.sh runs one in CI.
set -euo pipefail
driver=$1 log=$2
work=${AGENT_RESOURCE_WORKSPACE:?run-vm-test runs inside agent-resource run}
# Short paths keep the QEMU control sockets below the Unix socket length limit.
mkdir -p "$work/runtime" "$work/output"
chmod 700 "$work/runtime"
TMPDIR="$work" XDG_RUNTIME_DIR="$work/runtime" timeout --signal=TERM --kill-after=60s 60m \
  "$driver/bin/nixos-test-driver" -o "$work/output" >"$log" 2>&1 || { tail -n 60 "$log"; exit 1; }
