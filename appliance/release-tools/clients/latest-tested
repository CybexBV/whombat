#!/usr/bin/env bash
# The “latest tested” job (SUB-09, CT-74; docs/runbooks/client-latest-tested.md). For Claude Code it finds upstream's
# latest release, and when the published client channel doesn't have it yet it tests it: the official artifact checked
# against the vendor digest, a scratch clone of Whombat moved to that version (bump-pins.mjs), the provider fixture
# regenerated from the new executable when Whombat still has one, the agent-runtime tests run (the offline binary tests
# included). Only a version whose tests pass is built into a bundle and published in a new signed channel; without new
# versions the channel is re-signed before it expires. It never changes Whombat's committed pins and never pushes.
# Claude Code only: ChatGPT runs on Hermes's own provider with no client, so Codex is no longer tested or published;
# Codex bundles already in the channel stay until withdrawn (IN-432; Whombat HN-04). Never past the version Whombat's
# branch pins (CLAUDE_BUNDLE.version, the newest Claude Code Nous's DirectSDK is known to handle, Whombat HN-K08): a newer
# upstream release is held back and the pin itself is tested instead; `--version claude=X` is a person's explicit
# choice and isn't held back (IN-433). The channel is the GitHub repository's (Whombat LNK-24; ONE-01: one environment):
# signed in the publisher's clone of it and uploaded there (its files, then its role, `tufrepo gh-clients`), which
# every box reads. A repository named in WB_CLIENTS_REPO that isn't the clone (DEV's, before it was retired) publishes
# there and is mirrored into the clone byte for byte, as before ONE-01.
#
#   latest-tested [--dry-run] [--retry-failed] [--only claude] [--version claude=version]
#
# Settings (environment, e.g. from ~/.config/whombat/clients-latest-tested.env):
#   WB_CLIENTS_REPO      TUF repository to publish into (default: the publisher's clone, WB_CLIENTS_GITHUB)
#   WB_CLIENTS_KEY       clients role key file (default: the repository's own development clients key)
#   WB_CLIENTS_WHOMBAT   Whombat repository to clone (default ~/Code/Whombat), WB_CLIENTS_BRANCH (default main)
#   WB_CLIENTS_STATE     state, logs, bundles and artifacts (default ~/.local/state/whombat-clients)
#   WB_CLIENTS_ARCH      the architecture tested and published (default: this host's; tests must run on it)
#   WB_CLIENTS_ADAPTER_CLAUDE  adapter level when Whombat doesn't export CLIENT_ADAPTER_LEVELS (default 1)
#   WB_CLIENTS_GITHUB    the publisher's clone of whombat-releases (default $WHOMBAT_RELEASES_DIR; both, and the token
#                        WHOMBAT_RELEASES_TOKEN, are read from WB_CLIENTS_RELEASES_ENV, default
#                        ~/.config/whombat/releases.env, as whombat-ops candidate does).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
appliance="$(cd "$here/../.." && pwd)"
export TMPDIR="${TMPDIR:-$HOME/.cache/wb-tmp}"
mkdir -p "$TMPDIR"
# Without links: Whombat's tests compare the paths they make with what processes report, and ~/.cache is a link on a
# host whose caches live on another disk.
TMPDIR="$(realpath "$TMPDIR")"
KEY="${WB_CLIENTS_KEY:-}"
WHOMBAT="${WB_CLIENTS_WHOMBAT:-$HOME/Code/Whombat}"
BRANCH="${WB_CLIENTS_BRANCH:-main}"
STATE="${WB_CLIENTS_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/whombat-clients}"
case "$(uname -m)" in aarch64 | arm64) host_arch=aarch64 ;; *) host_arch=x86_64 ;; esac
ARCH="${WB_CLIENTS_ARCH:-$host_arch}"
RELEASES_ENV="${WB_CLIENTS_RELEASES_ENV:-$HOME/.config/whombat/releases.env}"
if [ -f "$RELEASES_ENV" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$RELEASES_ENV"
  set +a
fi
GITHUB="${WB_CLIENTS_GITHUB:-${WHOMBAT_RELEASES_DIR:-}}"
REPO="${WB_CLIENTS_REPO:-$GITHUB}"
[ -n "$REPO" ] || { echo "latest-tested: no repository: WHOMBAT_RELEASES_DIR (the publisher's clone, $RELEASES_ENV) or WB_CLIENTS_REPO" >&2; exit 2; }
dry=0 retry=0 only="claude"
declare -A forced=()
while [ $# -gt 0 ]; do
  case "$1" in
  --dry-run) dry=1 ;;
  --retry-failed) retry=1 ;;
  --only) only="$2"; shift ;;
  --version) forced["${2%%=*}"]="${2#*=}"; shift ;;
  *) echo "latest-tested: unknown argument $1" >&2; exit 2 ;;
  esac
  shift
done
for p in $only "${!forced[@]}"; do
  [ "$p" = claude ] || { echo "latest-tested: only Claude Code is tested and published; $p isn't (IN-432)" >&2; exit 2; }
done
[ "$ARCH" = "$host_arch" ] || { echo "latest-tested: the tests run on this host ($host_arch); $ARCH needs its own runner" >&2; exit 2; }
# Publishing needs the delegated clients role; say so before spending a test run on it (the GitHub repository carries it
# from gh-continue; a repository of dev/up gets it from a manager that installs clients, IN-37).
if [ "$dry" = 0 ] && ! compgen -G "$REPO/metadata/*.clients.json" >/dev/null; then
  echo "latest-tested: $REPO has no clients role, or --dry-run" >&2
  exit 2
fi
# The GitHub repository takes part once its clone exists (tufrepo gh-init); it needs the token then.
github=0
if [ "$dry" = 0 ] && [ -n "$GITHUB" ] && [ -d "$GITHUB/.git" ]; then
  [ -n "${WHOMBAT_RELEASES_TOKEN:-}" ] || { echo "latest-tested: $GITHUB is the GitHub repository's clone, but WHOMBAT_RELEASES_TOKEN is empty ($RELEASES_ENV)" >&2; exit 2; }
  compgen -G "$GITHUB/metadata/*.clients.json" >/dev/null || { echo "latest-tested: $GITHUB has no clients role (tufrepo gh-continue carries it)" >&2; exit 2; }
  github=1
fi

mkdir -p "$STATE"/{bin,logs,bundles,artifacts,markers,work}
exec 9>"$STATE/job.lock"
flock -n 9 || { echo "latest-tested: another run holds $STATE/job.lock"; exit 0; }
log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }

(cd "$appliance" && go build -o "$STATE/bin/clientchannel" ./release-tools/cmd/clientchannel)
cc="$STATE/bin/clientchannel"
if [ "$github" = 1 ]; then
  (cd "$appliance" && go build -o "$STATE/bin/tufrepo" ./release-tools/cmd/tufrepo)
fi
keyargs=()
[ -n "$KEY" ] && keyargs=(--key-file "$KEY")

pinned() { # Claude Code's version pinned on Whombat's branch ("" when it can't be read)
  git -C "$WHOMBAT" show "$BRANCH:packages/agent-runtime/src/providers/bundles.ts" 2>/dev/null |
    sed -n "/^export const CLAUDE_BUNDLE/,/^  version:/s/^  version: '\([0-9][0-9.]*\)',.*/\1/p" | head -n1
}

current() { # provider → the channel's newest version for ARCH ("" when none)
  "$cc" show --repo "$REPO" 2>/dev/null |
    jq -r --arg p "$1" --arg a "$ARCH" '[.payload.bundles[] | select(.provider == $p and .arch == $a)][0].version // ""' 2>/dev/null || true
}

# test_version provider version → bundle JSON in $STATE/bundles on success.
test_version() {
  local p="$1" v="$2" w="$STATE/work/$1-$2" logf="$STATE/logs/$1-$2-$(date -u +%Y%m%dT%H%M%SZ).log"
  local out="$STATE/bundles/$p-$v-$ARCH.json"
  log "testing $p $v (log $logf)"
  # A bundle that passed before stays until this run's own passes: the dev stack seeds its client channel from it.
  rm -f "$out.new"
  rm -rf "$w" && mkdir -p "$w"
  # The subshell stops at the first failing step (errexit; never call this from an `if`, which would disable it).
  set +e
  (
    set -euo pipefail
    "$cc" fetch --provider "$p" --version "$v" --arch "$ARCH" --dir "$w/dl" >"$w/fetched.json"
    git clone --quiet --depth 1 --branch "$BRANCH" "file://$WHOMBAT" "$w/whombat" # scratch: never pushed anywhere
    node "$here/bump-pins.mjs" --whombat "$w/whombat" --fetched "$w/fetched.json" >"$w/bump.json"
    cat "$w/bump.json"
    cd "$w/whombat"
    # The npm platform packages move to the new version (their integrity comes from the registry).
    pnpm install --no-frozen-lockfile
    fixture="$(jq -r '.fixture // empty' "$w/bump.json")"
    if [ -n "$fixture" ]; then
      # A Whombat that still has Claude Code's protocol fixture (before hermes-native.md HN-K01): regenerated from
      # the new executable, and the bundle names its digest.
      pnpm --filter @whombat/agent-runtime provider:fixtures --only "$p"
    fi
    pnpm --filter @whombat/agent-runtime test
    if [ -n "$fixture" ]; then
      digest="sha256:$(sha256sum "$fixture" | cut -d' ' -f1)"
    else
      # No fixture: the tests ran against the executable itself, whose digest the bundle names (IN-432).
      digest="sha256:$(jq -r .sha256 "$w/fetched.json")"
    fi
    adapter="$(jq -r '.adapter // empty' "$w/bump.json")"
    var="WB_CLIENTS_ADAPTER_${p^^}"
    adapter="${adapter:-${!var:-1}}"
    "$cc" bundle --fetched "$w/fetched.json" --fixtures-digest "$digest" --adapter "$adapter" \
      --work "$STATE/artifacts" --out "$out.new"
  ) >"$logf" 2>&1
  local rc=$? # errexit stays off until the caller has the result
  if [ "$rc" = 0 ] && [ -s "$out.new" ]; then
    mv -f "$out.new" "$out"
    touch "$STATE/markers/$p-$v-$ARCH.ok"
    rm -f "$STATE/markers/$p-$v-$ARCH.failed"
    rm -rf "$w"
    log "$p $v passed"
    return 0
  fi
  rm -f "$out.new"
  echo "$logf" >"$STATE/markers/$p-$v-$ARCH.failed"
  rm -f "$STATE/markers/$p-$v-$ARCH.ok"
  rm -rf "$w/whombat/node_modules" "$w/dl"
  log "$p $v FAILED; nothing is published for it (log $logf; tail below)"
  tail -n 40 "$logf" | sed 's/^/  | /'
  return 1
}

new=()
failed=0
for p in $only; do
  v="${forced[$p]:-}"
  if [ -z "$v" ]; then
    v="$("$cc" latest --provider "$p")" || { log "$p: upstream's latest release is unknown; skipped"; failed=1; continue; }
    pin="$(pinned)"
    if [ -z "$pin" ]; then
      log "$p: can't read the version Whombat's $BRANCH pins; skipped (IN-433)"
      failed=1
      continue
    fi
    if [ "$(printf '%s\n%s\n' "$v" "$pin" | sort -V | tail -n1)" != "$pin" ]; then
      log "$p: upstream $v is newer than Whombat's pin $pin, the newest DirectSDK is known to handle; $pin instead (IN-433)"
      v="$pin"
    fi
  fi
  cur="$(current "$p")"
  if [ "$cur" = "$v" ] && [ -z "${forced[$p]:-}" ]; then
    log "$p: $v is already in the channel"
    continue
  fi
  if [ -f "$STATE/markers/$p-$v-$ARCH.failed" ] && [ "$retry" = 0 ] && [ -z "${forced[$p]:-}" ]; then
    log "$p: $v failed before ($(cat "$STATE/markers/$p-$v-$ARCH.failed")); --retry-failed to test it again"
    continue
  fi
  log "$p: upstream $v, channel ${cur:-none}"
  # Not in an `if`: errexit would be ignored in everything test_version runs, its test subshell included.
  set +e
  test_version "$p" "$v"
  rc=$?
  set -e
  if [ "$rc" = 0 ]; then
    new+=(--bundle "$STATE/bundles/$p-$v-$ARCH.json")
  else
    failed=1
  fi
done

if [ "$dry" = 1 ]; then
  log "dry run: nothing published (${#new[@]} bundle arguments ready)"
elif [ ${#new[@]} -gt 0 ]; then
  "$cc" publish --repo "$REPO" "${keyargs[@]}" "${new[@]}"
else
  # Within 5½ days: run every 6 h, the 7-day channel keeps more than the 5 days below which control's
  # client_channel_expiring opens (UP-G2), which the dev control checks too (IN-224).
  "$cc" refresh --repo "$REPO" "${keyargs[@]}" --within 132h
fi
# The channel into the GitHub repository: signed in the clone (published there directly, or mirrored from another
# repository), then its files uploaded and its role pushed. The next run (or `tufrepo gh-clients --dir <clone>`)
# finishes one that stopped.
if [ "$github" = 1 ]; then
  set +e
  if [ "$(realpath "$REPO")" = "$(realpath "$GITHUB")" ]; then
    "$STATE/bin/tufrepo" gh-clients --dir "$GITHUB" >/dev/null
  else
    "$cc" mirror --from "$REPO" --repo "$GITHUB" "${keyargs[@]}" && "$STATE/bin/tufrepo" gh-clients --dir "$GITHUB" >/dev/null
  fi
  rc=$?
  set -e
  if [ "$rc" = 0 ]; then
    log "GitHub: the client channel is on releases.whombat.com"
  else
    log "GitHub: the client channel didn't go up (see above); the next run tries again"
    failed=1
  fi
fi
# Artifacts and bundles of published versions stay in the repository; local copies older than 30 days go.
find "$STATE/artifacts" "$STATE/bundles" -type f -mtime +30 -delete 2>/dev/null || true
find "$STATE/logs" -type f -mtime +60 -delete 2>/dev/null || true
exit "$failed"
