{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@whombat/avatars": ["./vendor/whombat-app/avatars/src/index.ts"],
      "@whombat/avatars/react": ["./vendor/whombat-app/avatars/src/react.tsx"],
      "@whombat/avatars/urls": ["./vendor/whombat-app/avatars/src/urls.ts"],
      "@whombat/brand": ["./vendor/whombat-app/brand/src/index.ts"],
      "@whombat/brand/react": ["./vendor/whombat-app/brand/src/react.tsx"],
      "@whombat/screen": ["./vendor/whombat-app/screen/src/index.ts"],
      "@whombat/screen/react": ["./vendor/whombat-app/screen/src/react.tsx"],
      "@whombat/screen/fixtures": ["./vendor/whombat-app/screen/src/fixtures.ts"]
    }
  },
  "include": ["src", "scripts", "*.config.ts"]
}
