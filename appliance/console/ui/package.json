{
  "name": "whombat-console-ui",
  "license": "AGPL-3.0-only",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "description": "The appliance's graphical installer and tty1 console (CG-01…CG-17): one local web page, two modes.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "biome check . && tsc --noEmit && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "shots": "node scripts/shots.ts",
    "vendor": "scripts/vendor-app.sh"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
