  "annotations": [
    {
      "match": {
        "namePrefix": "whombat-provider-codex"
      },
      "category": "proprietary",
      "license": "LicenseRef-OpenAI-Codex-release",
      "note": "OpenAI Codex CLI release binary, fetched by hash from the upstream GitHub release, unmodified (nix/packages/providers.nix). Upstream source is Apache-2.0, but the shipped artifact is a vendor-built binary with bundled components; redistribution terms and commercial use gated by blockers X-02"
    },
    {
      "match": {
        "namePrefix": "whombat-provider-claude"
      },
      "category": "proprietary",
      "license": "LicenseRef-Anthropic-Commercial-Terms",
      "note": "Anthropic Claude Code binary (claude-agent-sdk-linux-x64 npm tarball), fetched by hash, unmodified (E-C1). Proprietary; use requires Anthropic Commercial Terms acceptance (blockers X-01)"
    },
    {
      "match": {
        "group": "@anthropic-ai",
        "namePrefix": "claude-agent-sdk"
      },
      "category": "proprietary",
      "license": "LicenseRef-Anthropic-Commercial-Terms",
      "note": "Claude Agent SDK npm package (license: SEE LICENSE IN README/LICENSE.md, Anthropic's terms); the linux-x64 package bundles the Claude Code binary. Runtime dependency of the Whombat runtime; commercial use gated by blockers X-01, managed mode refuses SDK + subscription auth (provider-evidence.md)"
    },
    {
      "match": {
        "name": "com.whombat/whombat-live",
        "sbom": "whombat-app-android"
      },
      "category": "first-party",
      "note": "Whombat native module (apps/mobile/modules/whombat-live)"
    },
    {
      "match": {
        "name": "whombat-live",
        "group": "com.whombat"
      },
      "category": "first-party",
      "note": "Whombat native module (apps/mobile/modules/whombat-live)"
    },
    {
      "match": {
        "nameIn": [
          "glibc-locales",
          "getent-glibc"
        ],
        "sbomPrefix": "nix-"
      },
      "license": "LGPL-2.1-or-later",
      "note": "output of glibc; nixpkgs meta carries no license for it (manual annotation, same as glibc)"
    },
    {
      "match": {
        "name": "icu4c",
        "sbomPrefix": "nix-"
      },
      "license": "Unicode-3.0",
      "note": "ICU; nixpkgs meta carries no license here (manual annotation: ICU is under the Unicode license)"
    },
    {
      "match": {
        "namePrefix": "postgresql-and-plugins",
        "sbomPrefix": "nix-"
      },
      "license": "PostgreSQL",
      "note": "NixOS wrapper around postgresql (manual annotation)"
    },
    {
      "match": {
        "nameIn": [
          "nix-info",
          "nixos-build-vms"
        ],
        "sbomPrefix": "nix-"
      },
      "license": "MIT",
      "note": "NixOS helper script from nixpkgs (MIT; manual annotation)"
    },
    {
      "match": {
        "name": "hostname-hostname-debian",
        "sbomPrefix": "nix-"
      },
      "license": "GPL-2.0-or-later",
      "note": "output of hostname-debian (manual annotation)"
    },
    {
      "match": {
        "name": "dbus-1",
        "sbomPrefix": "nix-"
      },
      "category": "not-applicable",
      "note": "generated D-Bus configuration directory"
    },
    {
      "match": {
        "group": "@whombat"
      },
      "category": "first-party",
      "note": "Whombat package (workspace or vendored whombat-contracts tarball): ours, AGPL-3.0-only (HE-63)"
    },
    {
      "match": {
        "namePrefix": "github.com/CybexBV/"
      },
      "category": "first-party",
      "note": "Whombat Go module: ours, AGPL-3.0-only (the relay's, github.com/CybexBV/whombat-cloud/relay: proprietary; HE-63)"
    },
    {
      "match": {
        "nameMatch": "^github\\.com/[^/]+/whombat-(appliance|contracts)(/|$)"
      },
      "category": "first-party",
      "note": "the same modules under the paths they had until 2026-11-21, each named after the repository it was in then: in the bill of materials of an earlier release"
    },
    {
      "match": {
        "nameIn": [
          "rackoon",
          "rackoon-web",
          "hermes-whombat"
        ]
      },
      "category": "first-party",
      "note": "ours, AGPL-3.0-only (HE-63): whombat-hosts' Go module and web UI (they keep the names from Rackoon) and Whombat's Hermes plugin (packages/hermes-whombat)"
    },
    {
      "match": {
        "name": "./third_party/whombat-contracts-go"
      },
      "category": "first-party",
      "note": "vendored whombat-contracts Go module: ours, AGPL-3.0-only (HE-63)"
    },
    {
      "match": {
        "namePrefix": "whombat-",
        "sbomPrefix": "nix-"
      },
      "category": "first-party",
      "note": "Whombat package or generated Whombat configuration in the NixOS closure: ours, AGPL-3.0-only (HE-63)"
    },
    {
      "match": {
        "name": "std"
      },
      "license": "BSD-3-Clause",
      "note": "Go standard library (https://go.dev/LICENSE); cyclonedx-gomod does not detect it"
    },
    {
      "match": {
        "noPosition": true,
        "sbomPrefix": "nix-"
      },
      "category": "not-applicable",
      "note": "generated by the NixOS module system (unit, configuration or wrapper file), not a third-party package"
    }
  ],
  "crossRefs": {
    "$comment": "Android modules compiled as local Gradle subprojects from npm packages carry no license in their POM; they take the license of the npm package (whombat-app-mobile-js SBOM).",
