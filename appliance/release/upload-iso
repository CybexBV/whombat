#!/usr/bin/env bash
# release/upload-iso — put a Production release's installer ISO on the download site (Whombat ENV-22, ENV-15):
# Cloudflare R2, public through the bucket's own domain. GitHub takes no file of 2 GiB or more, and the ISO is about
# 3.6 GiB (LNK-24).
#
#   release/upload-iso <release dir> --production [--version vX.Y] [--bucket B] [--base-url URL] [--dry-run]
#
# <release dir> is a host release's folder with its ISO (`release/build iso <dir>`: iso.json, iso/<file>). The site
# holds one installer, named by its own version: one more than the version installer/latest.json names, `v0.1` when it
# names none, the same again for the release it names already (a run again, or a release without an ISO of its own);
# --version sets a higher one by hand (`v1.0` only on John's word). Sent, in this order, so nothing ever names a file
# that isn't there yet:
#   whombat-installer-vX.Y.iso          the ISO, at the root of the site (checked against iso.json's sha256 and size
#                                       first; copied on the bucket from the installer latest.json names when that is
#                                       the same file, else uploaded)
#   whombat-installer-vX.Y.iso.sha256   `<sha256>  whombat-installer-vX.Y.iso` (`sha256sum -c` reads it)
#   installer/latest.json               {v: 2, version, releaseId, file, size, sha256, url, sha256Url, publishedAt},
#                                       cached 5 minutes; the website takes its links from it
# Then every older installer is removed from the bucket: the root's other whombat-installer-* files, and
# installer/<release-id>/ and installer/latest/ (the layout before ENV-22). That waits until the cache in front of
# latest.json (whombat.com keeps it 5 minutes; the download site's own isn't cached) can't name an older one any more:
# WHOMBAT_INSTALLER_SETTLE seconds after latest.json's publishedAt (360). Files are compared by digest, never by size (R1 #14): the object's
# ETag, which for one PUT is the MD5 of its bytes, asked of the public site with a query of its own so no cache answers.
# A file the site serves with the same digest is not sent again (a stopped upload is run again); one it serves with
# another digest under the same name is refused before anything is sent: a version never names two installers. The
# installer only moves forward (R2 B2): when latest.json names a newer release, nothing is sent and the run says so
# (exit 3); a latest.json the site can't give, or that names no release, stops the run before anything changes (only a
# 404 is no latest.json). Until latest.json names the new installer the old one stays whole, so a run that stops leaves
# the site as it was or with a file nothing names yet; a run again carries on.
#
# Settings: the bucket (--bucket, else WHOMBAT_INSTALLER_BUCKET) and the site's public base URL (--base-url, else
# WHOMBAT_INSTALLER_BASE_URL, https, no trailing slash). The credentials are read from
# ~/.config/cloudflare-r2/credentials.env (WHOMBAT_R2_CREDENTIALS) inside the request's own subshell only: the key goes
# to curl on its standard input (`-K -`), never on a command line, in the environment of anything else, or in a log.
# One PUT per file (curl --aws-sigv4), so at most 5 GiB each. --dry-run reads the site's latest.json and says what it
# would do; it reads no credentials and changes nothing.
set -euo pipefail

die() {
  echo "upload-iso: $*" >&2
  exit 1
}
say() { echo "upload-iso: $*" >&2; }
usage() {
  sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//' >&2
  exit 2
}

[ $# -ge 1 ] || usage
case $1 in -h | --help) usage ;; esac
dir=$1
shift
production=false dry=false want_version=""
bucket=${WHOMBAT_INSTALLER_BUCKET:-}
base=${WHOMBAT_INSTALLER_BASE_URL:-}
while [ $# -gt 0 ]; do
  case $1 in
    --production) production=true; shift ;;
    --version) want_version=${2:?}; shift 2 ;;
    --bucket) bucket=${2:?}; shift 2 ;;
    --base-url) base=${2:?}; shift 2 ;;
    --dry-run) dry=true; shift ;;
    -h | --help) usage ;;
    *) die "unknown option $1" ;;
  esac
done
creds=${WHOMBAT_R2_CREDENTIALS:-$HOME/.config/cloudflare-r2/credentials.env}
settle=${WHOMBAT_INSTALLER_SETTLE:-360}
# S3's limit for one PUT.
max=$((5 * 1024 * 1024 * 1024))
version_re='^v(0|[1-9][0-9]{0,3})\.(0|[1-9][0-9]{0,5})$'
id_re='^whombat-[0-9]{8}\.[1-9][0-9]{0,3}$'

# The site holds one installer, the newest Production release's (ENV-22): a Beta release's never goes up.
$production || die "only a Production release's installer goes on the download site: pass --production (whombat-ops promote does)"
[ -f "$dir/iso.json" ] || die "$dir has no iso.json: build the ISO first (release/build iso $dir)"
[[ $bucket =~ ^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$ ]] || die "the bucket (--bucket or WHOMBAT_INSTALLER_BUCKET) is missing or not a bucket name"
base=${base%/}
[[ $base =~ ^https://[A-Za-z0-9.-]+$ ]] || die "the base URL (--base-url or WHOMBAT_INSTALLER_BASE_URL) must be an https origin"
[ -z "$want_version" ] || [[ $want_version =~ $version_re ]] || die "--version $want_version is not a version like v0.12"
[[ $settle =~ ^[0-9]+$ ]] || die "WHOMBAT_INSTALLER_SETTLE must be a number of seconds"

id=$(jq -er .releaseId "$dir/iso.json")
file=$(jq -er .file "$dir/iso.json")
want_sha=$(jq -er .sha256 "$dir/iso.json")
want_size=$(jq -er .size "$dir/iso.json")
# One id family since ONE-04; the DEV image's and the community edition's ISOs aren't published here.
[[ $id =~ $id_re ]] || die "$id is not a release id of the Whombat image (whombat-YYYYMMDD.N)"
[[ $file =~ ^[A-Za-z0-9._-]+\.iso$ ]] || die "iso.json names a strange file: $file"
[[ $want_sha =~ ^[0-9a-f]{64}$ ]] || die "iso.json's sha256 is not one"
iso=$dir/iso/$file
[ -f "$iso" ] || die "$iso is missing"
size=$(stat -c %s "$iso")
[ "$size" = "$want_size" ] || die "$iso is $size bytes, iso.json says $want_size"
[ "$size" -le "$max" ] || die "$iso is $size bytes: more than one PUT takes (5 GiB)"
say "checking $file ($size bytes)"
sha=$(sha256sum "$iso" | cut -d' ' -f1)
[ "$sha" = "$want_sha" ] || die "$iso's sha256 is $sha, iso.json says $want_sha"
iso_md5=$(md5sum "$iso" | cut -d' ' -f1)

work=$(mktemp -d "${TMPDIR:-/tmp}/upload-iso.XXXXXX")
trap 'rm -rf "$work"' EXIT

# One question for every check of this run, so no cache on the way answers it (Cloudflare keys its cache on the query).
nonce=$(date +%s%N)
# What the site serves at a key now: "missing" (404), "noetag" (served, but no ETag to compare), else its ETag (the
# object's MD5 for one PUT or a copy of one), quotes and a weak prefix taken off.
served_etag() {
  local head status tag
  head=$(curl -sI --max-time 30 "$base/$1?verify=$nonce" | tr -d '\r') || { echo unreachable; return 0; }
  status=$(awk 'NR == 1 { print $2 }' <<<"$head")
  case $status in
    404) echo missing; return 0 ;;
    200) ;;
    *) echo "status-${status:-none}"; return 0 ;;
  esac
  tag=$(awk 'tolower($1) == "etag:" { print $2 }' <<<"$head" | tail -n1 | sed 's#^W/##; s#"##g')
  echo "${tag:-noetag}"
}
md5_of() { md5sum "$1" | cut -d' ' -f1; }

# r2_request <path after the bucket> <curl args…>: one signed request, its answer's body on standard output. The
# credentials live in this subshell only, unexported: curl gets the key on its standard input.
r2_request() {
  local path=$1
  shift
  (
    set +x
    # shellcheck disable=SC1090
    . "$creds"
    [ -n "${R2_ENDPOINT:-}" ] && [ -n "${R2_ACCESS_KEY_ID:-}" ] && [ -n "${R2_SECRET_ACCESS_KEY:-}" ] ||
      { echo "upload-iso: $creds lacks R2_ENDPOINT, R2_ACCESS_KEY_ID or R2_SECRET_ACCESS_KEY" >&2; exit 1; }
    printf 'user = "%s:%s"\n' "$R2_ACCESS_KEY_ID" "$R2_SECRET_ACCESS_KEY" |
      env -u R2_ACCESS_KEY_ID -u R2_SECRET_ACCESS_KEY -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY \
        curl -sS --fail-with-body -K - --aws-sigv4 aws:amz:auto:s3 "$@" "${R2_ENDPOINT%/}/$bucket$path"
  )
}
# r2 <key> <curl args…>: one signed request for <key> in the bucket; its answer's body is thrown away.
r2() {
  local key=$1
  shift
  r2_request "/$key" -o /dev/null "$@"
}

# put <local file> <key> <content type> [cache-control]: one signed PUT.
put() {
  local src=$1 key=$2 type=$3 cache=${4:-}
  if $dry; then
    say "would upload $key ($(stat -c %s "$src") bytes, $type${cache:+, $cache})"
    return 0
  fi
  [ -f "$creds" ] || die "no credentials file $creds"
  r2 "$key" -H "Content-Type: $type" ${cache:+-H "Cache-Control: $cache"} -T "$src" || die "the upload of $key failed"
  say "uploaded $key"
}

# copy_or_put <local file> <key there already> <key> <content type>: the bucket copies the file it has (S3 CopyObject:
# 3.6 GiB not sent twice); when it can't, the file is uploaded.
copy_or_put() {
  local src=$1 from=$2 key=$3 type=$4
  if $dry; then
    say "would copy $from to $key ($type)"
    return 0
  fi
  [ -f "$creds" ] || die "no credentials file $creds"
  if r2 "$key" -X PUT -H "x-amz-copy-source: /$bucket/$from" -H "x-amz-metadata-directive: REPLACE" \
    -H "Content-Type: $type" 2>/dev/null; then
    say "copied $from to $key"
  else
    say "the bucket didn't copy $from: uploading $key"
    put "$src" "$key" "$type"
  fi
}

# delete <key>: one signed DELETE.
delete() {
  r2 "$1" -X DELETE || return 1
  say "removed $1"
}

# keys <prefix>: every key in the bucket that starts with <prefix>, one a line (ListObjectsV2, a page at a time).
keys() {
  local q token="" page
  while :; do
    q="list-type=2&prefix=$(jq -rn --arg p "$1" '$p | @uri')"
    [ -z "$token" ] || q="$q&continuation-token=$(jq -rn --arg t "$token" '$t | @uri')"
    page=$(r2_request "?$q") || return 1
    grep -o '<Key>[^<]*</Key>' <<<"$page" | sed 's#</\{0,1\}Key>##g' || true
    grep -q '<IsTruncated>true</IsTruncated>' <<<"$page" || return 0
    token=$(grep -o '<NextContinuationToken>[^<]*' <<<"$page" | sed 's#<NextContinuationToken>##')
    [ -n "$token" ] || return 1
  done
}

# older a b: release id a (whombat-YYYYMMDD.N) sorts before b.
older() {
  local a=${1#whombat-} b=${2#whombat-}
  [ "${a%%.*}" -lt "${b%%.*}" ] || { [ "${a%%.*}" = "${b%%.*}" ] && [ "${a#*.}" -lt "${b#*.}" ]; }
}
# higher a b: version a (vX.Y) is above b.
higher() {
  local a=${1#v} b=${2#v}
  [ "${a%%.*}" -gt "${b%%.*}" ] || { [ "${a%%.*}" = "${b%%.*}" ] && [ "${a#*.}" -gt "${b#*.}" ]; }
}
# again <what> <command…>: the command, tried twice more after a pause when it fails.
again() {
  local what=$1 i delay=${UPLOAD_RETRY_DELAY:-5}
  shift
  for i in 1 2 3; do
    if ("$@"); then return 0; fi
    [ "$i" = 3 ] && break
    say "$what failed; trying again in $((delay * i)) s"
    sleep $((delay * i))
  done
  return 1
}

# needed <md5 here> <key>: whether a file must be sent: "no" when the site serves it with the same digest, "yes" when
# it lacks it; another digest under the same name stops the run (nothing is ever overwritten).
needed() {
  local want=$1 have
  have=$(served_etag "$2")
  case $have in
    "$want") echo no ;;
    missing) echo yes ;;
    noetag) die "the site serves $2 but says no digest (ETag): it can't be compared, so nothing is sent over it" ;;
    status-* | unreachable) die "the site answers $have for $2: nothing is sent until it answers 200 or 404" ;;
    *) die "the site serves another $2 (digest $have, this one's $want): a version never names two installers. latest.json doesn't name it, so a run that stopped left it: remove it and its .sha256 from the bucket, then run this again" ;;
  esac
}

# verify <md5 here> <key>: the site serves exactly this file (by digest), or the run stops.
verify() {
  local want=$1 have
  $dry && { say "would check that $base/$2 serves this file (its digest)"; return 0; }
  have=$(served_etag "$2")
  [ "$have" = "$want" ] || die "$base/$2 isn't this file (the site says ${have}, this one's digest is $want): latest.json is left as it was"
  say "$2: served, the same digest"
}

# The installer the site's latest.json names now: its release, version (none before ENV-22), file's key and time.
prev_id="" prev_version="" prev_url="" prev_key="" prev_at=""
state=$(served_etag installer/latest.json)
case $state in
  missing) ;;
  status-* | unreachable) die "the site answers $state for installer/latest.json: nothing is changed" ;;
  *)
    body=$(curl -sf --max-time 30 "$base/installer/latest.json?verify=$nonce") ||
      die "installer/latest.json can't be read: nothing is changed"
    prev_id=$(jq -er '.releaseId' <<<"$body" 2>/dev/null) || die "installer/latest.json isn't a manifest: nothing is changed"
    [[ $prev_id =~ $id_re ]] || die "installer/latest.json names $prev_id, no release id: nothing is changed"
    prev_version=$(jq -r '.version // empty' <<<"$body")
    [ -z "$prev_version" ] || [[ $prev_version =~ $version_re ]] || die "installer/latest.json says version $prev_version, which isn't one: nothing is changed"
    prev_url=$(jq -r '.url // empty' <<<"$body")
    [[ $prev_url == "$base/"* ]] && prev_key=${prev_url#"$base/"}
    prev_at=$(jq -r '.publishedAt // empty' <<<"$body")
    ;;
esac

# Only forward (R2 B2): a newer release's installer stays.
if [ -n "$prev_id" ] && older "$id" "$prev_id"; then
  say "installer/latest.json names $prev_id, newer than $id: its installer stays and nothing is sent"
  jq -n --arg id "$id" --arg k "$prev_id" --arg kv "$prev_version" --arg ku "$prev_url" --argjson d "$dry" \
    '{releaseId: $id, latest: false, latestKept: $k, keptVersion: (if $kv == "" then null else $kv end),
      keptUrl: (if $ku == "" then null else $ku end), dryRun: $d}'
  exit 3
fi
same=false
if [ "$prev_id" = "$id" ] && [ -n "$prev_version" ] && { [ -z "$want_version" ] || [ "$want_version" = "$prev_version" ]; }; then
  # Its installer is up already (a run again, or a release without an ISO of its own): the same version.
  version=$prev_version same=true
elif [ -n "$want_version" ]; then
  [ -z "$prev_version" ] || higher "$want_version" "$prev_version" ||
    die "--version $want_version isn't above $prev_version, the version the site has: a version never goes back"
  version=$want_version
elif [ -n "$prev_version" ]; then
  major=${prev_version#v} && major=${major%%.*}
  minor=${prev_version#*.}
  version=v$major.$((minor + 1))
else
  version=v0.1
fi

name=whombat-installer-$version.iso
url=$base/$name
say "$id's installer is $version: $url"
printf '%s  %s\n' "$sha" "$name" >"$work/$name.sha256"
sum_md5=$(md5_of "$work/$name.sha256")
# A run again keeps the time it was first published, so its latest.json is the same file.
at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
if $same && [ -n "$prev_at" ]; then at=$prev_at; fi
jq -n --arg ver "$version" --arg id "$id" --arg f "$name" --argjson n "$size" --arg s "$sha" --arg u "$url" --arg at "$at" \
  '{v: 2, version: $ver, releaseId: $id, file: $f, size: $n, sha256: $s, url: $u, sha256Url: ($u + ".sha256"), publishedAt: $at}' \
  >"$work/latest.json"
latest_md5=$(md5_of "$work/latest.json")

# The installer's two files, both checked before either is sent (a dry run asks too: the site is public).
send_iso=$(needed "$iso_md5" "$name")
send_sha=$(needed "$sum_md5" "$name.sha256")
send_latest=yes
[ "$(served_etag installer/latest.json)" != "$latest_md5" ] || send_latest=no
if [ "$send_iso" = yes ]; then
  # The same ISO under the name before (a release without an ISO of its own, or the layout before ENV-22): the
  # bucket copies it.
  if [ -n "$prev_key" ] && [ "$prev_key" != "$name" ] && [ "$(served_etag "$prev_key")" = "$iso_md5" ]; then
    again "the copy of the ISO" copy_or_put "$iso" "$prev_key" "$name" application/octet-stream ||
      die "the ISO couldn't be put on the site: run this again (latest.json still names the installer before)"
  else
    again "the upload of the ISO" put "$iso" "$name" application/octet-stream ||
      die "the ISO couldn't be put on the site: run this again (latest.json still names the installer before)"
  fi
else
  say "$name is there already (the same digest)"
fi
if [ "$send_sha" = yes ]; then
  again "the upload of the checksum" put "$work/$name.sha256" "$name.sha256" text/plain ||
    die "the checksum couldn't be put on the site: run this again (latest.json still names the installer before)"
else
  say "$name.sha256 is there already (the same digest)"
fi
verify "$iso_md5" "$name"
verify "$sum_md5" "$name.sha256"
if ! $dry; then
  served_sum=$(curl -sf --max-time 30 "$base/$name.sha256?verify=$nonce" | cut -d' ' -f1)
  [ "$served_sum" = "$sha" ] || die "$base/$name.sha256 names ${served_sum:-nothing}, not the ISO's $sha: latest.json is left as it was"
fi
if [ "$send_latest" = yes ]; then
  again "the upload of installer/latest.json" put "$work/latest.json" installer/latest.json application/json "max-age=300" ||
    die "installer/latest.json couldn't be put on the site: it still names the installer before; run this again"
  verify "$latest_md5" installer/latest.json
else
  say "installer/latest.json names $version already"
fi

# Every older installer goes (ENV-22), once no cache can name it any more.
removed=()
if $dry; then
  say "would wait until $settle s after latest.json's time, then remove every other whombat-installer-* file, installer/<release-id>/ and installer/latest/"
else
  list=$(keys whombat-installer- && keys installer/) || die "the bucket's files couldn't be listed: older installers stay; run this again"
  old=()
  while IFS= read -r k; do
    [ -n "$k" ] || continue
    case $k in "$name" | "$name.sha256" | "$name.sha256.sig") continue ;; esac
    if [[ $k =~ ^whombat-installer-[A-Za-z0-9._-]+$ ]] || [[ $k =~ ^installer/(whombat-[0-9]{8}\.[0-9]+|latest)/[A-Za-z0-9._-]+$ ]]; then
      old+=("$k")
    fi
  done <<<"$list"
  if [ ${#old[@]} -gt 0 ]; then
    published=$(date -u -d "$at" +%s 2>/dev/null || date -u +%s)
    wait_s=$((published + settle - $(date -u +%s)))
    if [ "$wait_s" -gt 0 ]; then
      say "waiting $wait_s s, until no cache names the installer before, then removing ${#old[@]} older files"
      sleep "$wait_s"
    fi
    for k in "${old[@]}"; do
      again "the removal of $k" delete "$k" ||
        die "$k couldn't be removed: the new installer is up and latest.json names it; run this again to remove the rest"
      removed+=("$k")
    done
  fi
fi
jq -n --arg ver "$version" --arg id "$id" --arg f "$name" --arg u "$url" --argjson d "$dry" \
  --args '{releaseId: $id, version: $ver, file: $f, url: $u, sha256Url: ($u + ".sha256"), latest: true, removed: $ARGS.positional, dryRun: $d}' \
  ${removed[@]+"${removed[@]}"}
