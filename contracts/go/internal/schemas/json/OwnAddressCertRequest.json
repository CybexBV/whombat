{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/OwnAddressCertRequest.json",
  "title": "OwnAddressCertRequest",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "host": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z](-?[a-z0-9])+[.]((box|dev)[.])?whombat[.]app$"
    }
  },
  "required": [
    "v"
  ],
  "additionalProperties": false
}
