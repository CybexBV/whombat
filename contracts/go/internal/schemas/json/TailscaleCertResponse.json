{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/TailscaleCertResponse.json",
  "title": "TailscaleCertResponse",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?([.][a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
    },
    "certPem": {
      "type": "string",
      "minLength": 64,
      "maxLength": 16384,
      "pattern": "^[\\n\\x20-\\x7e]+$"
    },
    "keyPem": {
      "type": "string",
      "minLength": 64,
      "maxLength": 16384,
      "pattern": "^[\\n\\x20-\\x7e]+$"
    },
    "notAfter": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "required": [
    "v",
    "name",
    "certPem",
    "keyPem",
    "notAfter"
  ]
}
