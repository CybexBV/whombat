{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/ReleaseTuple.json",
  "title": "ReleaseTuple",
  "type": "object",
  "properties": {
    "releaseId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]*$"
        },
        "storePath": {
          "type": "string",
          "maxLength": 211,
          "pattern": "^\\/nix\\/store\\/[0-9a-df-np-sv-z]{32}-[A-Za-z0-9+._?=-]+$"
        },
        "narHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "schemaReads": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "schemaWrites": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "protocol": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "hostAbi": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "storePath",
        "narHash",
        "schemaReads",
        "schemaWrites",
        "protocol",
        "hostAbi"
      ],
      "additionalProperties": false
    },
    "providers": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]*$"
          },
          "storePath": {
            "type": "string",
            "maxLength": 211,
            "pattern": "^\\/nix\\/store\\/[0-9a-df-np-sv-z]{32}-[A-Za-z0-9+._?=-]+$"
          },
          "narHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "required": [
          "version",
          "storePath",
          "narHash",
          "provider"
        ],
        "additionalProperties": false
      }
    },
    "host": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]*$"
        },
        "storePath": {
          "type": "string",
          "maxLength": 211,
          "pattern": "^\\/nix\\/store\\/[0-9a-df-np-sv-z]{32}-[A-Za-z0-9+._?=-]+$"
        },
        "narHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "abi": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "version",
        "storePath",
        "narHash",
        "abi"
      ],
      "additionalProperties": false
    },
    "manager": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]*$"
        },
        "storePath": {
          "type": "string",
          "maxLength": 211,
          "pattern": "^\\/nix\\/store\\/[0-9a-df-np-sv-z]{32}-[A-Za-z0-9+._?=-]+$"
        },
        "narHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "version",
        "storePath",
        "narHash"
      ],
      "additionalProperties": false
    },
    "clientFloor": {
      "type": "object",
      "properties": {
        "web": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "android": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "ios": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "desktop": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "cli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "web",
        "android",
        "ios",
        "desktop",
        "cli"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "releaseId",
    "runtime",
    "providers",
    "host",
    "manager"
  ],
  "additionalProperties": false
}
