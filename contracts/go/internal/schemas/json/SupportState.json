{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/SupportState.json",
  "title": "SupportState",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "available": {
      "type": "boolean"
    },
    "foreverAllowed": {
      "type": "boolean"
    },
    "helpCodeRequired": {
      "type": "boolean"
    },
    "environment": {
      "type": "string",
      "enum": [
        "local",
        "dev",
        "prod"
      ]
    },
    "hostKey": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI[A-Za-z0-9+/]{43}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "grant": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "look",
                "fix"
              ]
            },
            "since": {
              "type": "string",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "until": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 40,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "grantedBy": {
              "type": "object",
              "properties": {
                "accountId": {
                  "type": "string",
                  "pattern": "^acc_[A-Za-z0-9_-]{1,64}$",
                  "description": "acc_ id"
                },
                "name": {
                  "type": "string",
                  "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,120}$"
                }
              },
              "required": [
                "accountId",
                "name"
              ]
            },
            "helpCode": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{6}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "wrongCodes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "level",
            "since",
            "until",
            "grantedBy",
            "helpCode",
            "wrongCodes"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "connected": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "visitId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "who": {
            "type": "string",
            "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,40}$"
          },
          "since": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
          }
        },
        "required": [
          "visitId",
          "who",
          "since"
        ]
      }
    }
  },
  "required": [
    "v",
    "available",
    "foreverAllowed",
    "helpCodeRequired",
    "environment",
    "hostKey",
    "grant",
    "connected"
  ]
}
