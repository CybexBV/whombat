{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/TeamReportsActRequest.json",
  "title": "TeamReportsActRequest",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,64}$"
    },
    "reportId": {
      "type": "string",
      "pattern": "^tr_[A-Za-z0-9_-]{20}$"
    },
    "action": {
      "type": "string",
      "enum": [
        "works",
        "still_happening",
        "withdraw"
      ]
    }
  },
  "required": [
    "requestId",
    "reportId",
    "action"
  ],
  "additionalProperties": false
}
