{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/LicenceKeySet.json",
  "title": "LicenceKeySet",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "env": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$"
    },
    "keys": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kty": {
            "type": "string",
            "const": "OKP"
          },
          "crv": {
            "type": "string",
            "const": "Ed25519"
          },
          "kid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "x": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "alg": {
            "type": "string",
            "const": "EdDSA"
          },
          "use": {
            "type": "string",
            "const": "sig"
          }
        },
        "required": [
          "kty",
          "crv",
          "kid",
          "x"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "v",
    "env",
    "keys"
  ],
  "additionalProperties": false
}
