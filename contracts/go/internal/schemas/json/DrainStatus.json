{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/DrainStatus.json",
  "title": "DrainStatus",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "draining": {
      "type": "boolean"
    },
    "safe": {
      "type": "boolean"
    },
    "blockers": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "turn",
              "job",
              "approval-execution",
              "migration",
              "backup",
              "upload",
              "other"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "description": {
            "type": "string",
            "minLength": 0,
            "maxLength": 300,
            "pattern": "^[\\x20-\\x7e]*$"
          },
          "since": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "estimatedMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400000
          }
        },
        "required": [
          "kind",
          "id",
          "description",
          "since"
        ]
      }
    },
    "estimatedMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000
    }
  },
  "required": [
    "v",
    "requestId",
    "draining",
    "safe",
    "blockers",
    "estimatedMs"
  ]
}
