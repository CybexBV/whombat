{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/LicenceRenewResponse.json",
  "title": "LicenceRenewResponse",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "minLength": 16,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "renewAfterS": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    },
    "now": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    }
  },
  "required": [
    "token",
    "expiresAt",
    "renewAfterS",
    "now"
  ]
}
