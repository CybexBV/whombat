{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/SupportEventsAnswer.json",
  "title": "SupportEventsAnswer",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "events": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "at": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "grant",
              "stop",
              "expired",
              "visit_start",
              "visit_end",
              "locked_out"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "look",
              "fix"
            ]
          },
          "duration": {
            "type": "string",
            "enum": [
              "hour",
              "day",
              "week",
              "forever"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "owner",
              "desk",
              "expired",
              "wrong_codes"
            ]
          },
          "visitId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "who": {
            "type": "string",
            "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,40}$"
          },
          "startedAt": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "steps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "by": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "pattern": "^acc_[A-Za-z0-9_-]{1,64}$",
                "description": "acc_ id"
              },
              "name": {
                "type": "string",
                "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,120}$"
              }
            },
            "required": [
              "accountId",
              "name"
            ]
          }
        },
        "required": [
          "seq",
          "at",
          "kind"
        ]
      }
    },
    "next": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "v",
    "events",
    "next"
  ]
}
