{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/LicenceHeader.json",
  "title": "LicenceHeader",
  "type": "object",
  "properties": {
    "alg": {
      "type": "string",
      "const": "EdDSA"
    },
    "kid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "typ": {
      "type": "string",
      "const": "whombat-licence+jwt"
    }
  },
  "required": [
    "alg",
    "kid",
    "typ"
  ],
  "additionalProperties": false
}
