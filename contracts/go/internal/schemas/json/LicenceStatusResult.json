{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/LicenceStatusResult.json",
  "title": "LicenceStatusResult",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "licensed",
        "grace",
        "lapsed"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "active",
        "trial",
        "past_due",
        "payment",
        "not_renewed",
        "no_licence",
        "cancelled",
        "expired"
      ]
    },
    "plan": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "limits": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "devices": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "connectors": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "devices",
            "connectors"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "renewedAt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        },
        {
          "type": "null"
        }
      ]
    },
    "expiresAt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        },
        {
          "type": "null"
        }
      ]
    },
    "graceEndsAt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        },
        {
          "type": "null"
        }
      ]
    },
    "effectiveAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    }
  },
  "required": [
    "state",
    "reason",
    "plan",
    "limits",
    "renewedAt",
    "expiresAt",
    "graceEndsAt",
    "effectiveAt"
  ]
}
