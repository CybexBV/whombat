{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/OwnAddressCertResponse.json",
  "title": "OwnAddressCertResponse",
  "type": "object",
  "properties": {
    "serial": {
      "type": "string",
      "pattern": "^[0-9a-f]{2,64}$"
    },
    "spkiSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "notBefore": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "notAfter": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "host": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z]{3,10}-[a-z]{3,10}-[a-z]{3,10}[.](box|dev)[.]whombat[.]app$"
    },
    "certPem": {
      "type": "string",
      "minLength": 64,
      "maxLength": 16384,
      "pattern": "^[\\n\\x20-\\x7e]+$"
    },
    "keyPem": {
      "type": "string",
      "minLength": 64,
      "maxLength": 16384,
      "pattern": "^[\\n\\x20-\\x7e]+$"
    }
  },
  "required": [
    "serial",
    "spkiSha256",
    "notBefore",
    "notAfter",
    "v",
    "host",
    "certPem",
    "keyPem"
  ]
}
