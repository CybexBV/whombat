{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/AddressRegisterResponse.json",
  "title": "AddressRegisterResponse",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "minLength": 11,
      "maxLength": 32,
      "pattern": "^[a-z]{3,10}-[a-z]{3,10}-[a-z]{3,10}$"
    },
    "host": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z]{3,10}-[a-z]{3,10}-[a-z]{3,10}[.](box|dev)[.]whombat[.]app$"
    },
    "registeredAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    }
  },
  "required": [
    "label",
    "host",
    "registeredAt"
  ]
}
