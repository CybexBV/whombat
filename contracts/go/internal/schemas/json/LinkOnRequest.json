{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/LinkOnRequest.json",
  "title": "LinkOnRequest",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "contentProof": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "name": {
      "type": "string",
      "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,64}$"
    }
  },
  "required": [
    "v",
    "contentProof"
  ],
  "additionalProperties": false
}
