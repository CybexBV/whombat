{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/RelayRenew.json",
  "title": "RelayRenew",
  "type": "object",
  "properties": {
    "t": {
      "type": "string",
      "const": "renew"
    },
    "ticket": {
      "type": "string",
      "minLength": 16,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "t",
    "ticket"
  ]
}
