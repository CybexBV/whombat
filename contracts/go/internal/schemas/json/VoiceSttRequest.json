{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/VoiceSttRequest.json",
  "title": "VoiceSttRequest",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "audioWav": {
      "type": "string",
      "minLength": 60,
      "maxLength": 1280060,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    },
    "prompt": {
      "type": "string",
      "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,400}$"
    },
    "model": {
      "type": "string",
      "enum": [
        "auto",
        "parakeet",
        "whisper"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "auto",
        "en",
        "nl"
      ]
    }
  },
  "required": [
    "v",
    "audioWav"
  ],
  "additionalProperties": false
}
