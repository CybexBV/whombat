{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/WebPushRegistration.json",
  "title": "WebPushRegistration",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "const": "webpush"
    },
    "subscription": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 12,
          "maxLength": 2048,
          "pattern": "^https:[/][/][\\x21-\\x7e]+$"
        },
        "keys": {
          "type": "object",
          "properties": {
            "p256dh": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{87}$"
            },
            "auth": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{22}$"
            }
          },
          "required": [
            "p256dh",
            "auth"
          ],
          "additionalProperties": false
        },
        "expirationTime": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4102444800000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "endpoint",
        "keys",
        "expirationTime"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "platform",
    "subscription"
  ],
  "additionalProperties": false
}
