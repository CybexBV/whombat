{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/BluetoothDeviceAnswer.json",
  "title": "BluetoothDeviceAnswer",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "device": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^[0-9A-F]{2}(:[0-9A-F]{2}){5}$"
        },
        "name": {
          "type": "string",
          "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,80}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "keyboard",
            "mouse",
            "headphones",
            "headset",
            "speaker",
            "gamepad",
            "other"
          ]
        },
        "connected": {
          "type": "boolean"
        },
        "battery": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "signal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      },
      "required": [
        "address",
        "name",
        "kind",
        "connected"
      ]
    }
  },
  "required": [
    "v",
    "device"
  ]
}
