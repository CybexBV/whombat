{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/UpdateStatusResponse.json",
  "title": "UpdateStatusResponse",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "Assigned",
        "Downloading",
        "Verified",
        "Staged",
        "WaitingForSafeBoundary",
        "Activating",
        "Verifying",
        "Healthy",
        "Failed",
        "RolledBack",
        "Quarantined",
        "ForwardRepairRequired"
      ]
    },
    "current": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "knownGood": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "candidate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "explanation": {
      "type": "string",
      "minLength": 0,
      "maxLength": 500,
      "pattern": "^[\\x20-\\x7e]*$"
    },
    "failure": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "hold": {
      "type": "boolean"
    },
    "paused": {
      "type": "boolean"
    },
    "readOnly": {
      "type": "boolean"
    }
  },
  "required": [
    "state",
    "current",
    "knownGood",
    "hold",
    "readOnly"
  ]
}
