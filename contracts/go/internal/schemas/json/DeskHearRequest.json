{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/DeskHearRequest.json",
  "title": "DeskHearRequest",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "audioWav": {
      "type": "string",
      "minLength": 60,
      "maxLength": 12800060,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    }
  },
  "required": [
    "v",
    "audioWav"
  ],
  "additionalProperties": false
}
