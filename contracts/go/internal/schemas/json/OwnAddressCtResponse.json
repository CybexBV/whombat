{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/OwnAddressCtResponse.json",
  "title": "OwnAddressCtResponse",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "source": {
      "type": "string",
      "const": "certspotter"
    },
    "checkingSince": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "lastFreshAt": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "missed": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "to": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
          }
        },
        "required": [
          "from",
          "to"
        ]
      }
    },
    "hosts": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z](-?[a-z0-9])+[.]((box|dev)[.])?whombat[.]app$"
      }
    },
    "certs": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$"
          },
          "spkiSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "dnsNames": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^[*a-z0-9.-]+$"
            }
          },
          "notBefore": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "notAfter": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "issuer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[\\x20-\\x7e]*$"
          }
        },
        "required": [
          "id",
          "spkiSha256",
          "dnsNames",
          "notBefore",
          "notAfter",
          "issuer"
        ]
      }
    },
    "ordered": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "serial": {
            "type": "string",
            "pattern": "^[0-9a-f]{2,64}$"
          },
          "spkiSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "notBefore": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "notAfter": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
          }
        },
        "required": [
          "serial",
          "spkiSha256",
          "notBefore",
          "notAfter"
        ]
      }
    }
  },
  "required": [
    "v",
    "source",
    "checkingSince",
    "lastFreshAt",
    "missed",
    "certs",
    "ordered"
  ]
}
