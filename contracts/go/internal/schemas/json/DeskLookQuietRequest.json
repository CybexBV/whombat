{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/DeskLookQuietRequest.json",
  "title": "DeskLookQuietRequest",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "key": {
      "type": "string",
      "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,120}$"
    },
    "notice": {
      "type": "object",
      "properties": {
        "check": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
        },
        "subject": {
          "type": "string",
          "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,160}$"
        }
      },
      "required": [
        "check"
      ],
      "additionalProperties": false
    },
    "how": {
      "type": "string",
      "enum": [
        "ignore",
        "snooze"
      ]
    }
  },
  "required": [
    "v",
    "key",
    "notice",
    "how"
  ],
  "additionalProperties": false
}
