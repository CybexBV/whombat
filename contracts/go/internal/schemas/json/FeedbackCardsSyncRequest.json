{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/FeedbackCardsSyncRequest.json",
  "title": "FeedbackCardsSyncRequest",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "cards": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "card": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "sig": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{86}$"
          }
        },
        "required": [
          "card",
          "sig"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "seq",
    "cards"
  ],
  "additionalProperties": false
}
