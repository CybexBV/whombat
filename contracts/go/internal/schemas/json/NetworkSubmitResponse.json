{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/NetworkSubmitResponse.json",
  "title": "NetworkSubmitResponse",
  "type": "object",
  "properties": {
    "candidateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "applying",
        "confirming",
        "committed",
        "reverting",
        "reverted"
      ]
    }
  },
  "required": [
    "candidateId",
    "phase"
  ]
}
