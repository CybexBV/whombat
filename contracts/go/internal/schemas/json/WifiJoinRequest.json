{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/WifiJoinRequest.json",
  "title": "WifiJoinRequest",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "ssid": {
      "type": "string",
      "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,32}$"
    },
    "passphrase": {
      "type": "string",
      "pattern": "^([\\x20-\\x7e]{8,63}|[0-9A-Fa-f]{64})$"
    },
    "hidden": {
      "type": "boolean"
    },
    "confirmTimeoutSec": {
      "type": "integer",
      "minimum": 30,
      "maximum": 600
    }
  },
  "required": [
    "v",
    "ssid",
    "confirmTimeoutSec"
  ],
  "additionalProperties": false
}
