{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/BluetoothScanAnswer.json",
  "title": "BluetoothScanAnswer",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "scan": {
      "type": "object",
      "properties": {
        "until": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "devices": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string",
                "pattern": "^[0-9A-F]{2}(:[0-9A-F]{2}){5}$"
              },
              "name": {
                "type": "string",
                "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,80}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "keyboard",
                  "mouse",
                  "headphones",
                  "headset",
                  "speaker",
                  "gamepad",
                  "other"
                ]
              },
              "connected": {
                "type": "boolean"
              },
              "battery": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "signal": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              }
            },
            "required": [
              "address",
              "name",
              "kind",
              "connected"
            ]
          }
        }
      },
      "required": [
        "until",
        "devices"
      ]
    }
  },
  "required": [
    "v",
    "scan"
  ]
}
