{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/CheckpointRequest.json",
  "title": "CheckpointRequest",
  "type": "object",
  "properties": {
    "reason": {
      "type": "string",
      "enum": [
        "manual",
        "scheduled",
        "migration"
      ]
    },
    "releaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "migrations": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "underDrain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    }
  },
  "required": [
    "reason"
  ],
  "additionalProperties": false
}
