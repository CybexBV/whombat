{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/AdmissionClaims.json",
  "title": "AdmissionClaims",
  "type": "object",
  "properties": {
    "iss": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256,
      "pattern": "^https?:\\/\\/[\\x21-\\x7e]+$"
    },
    "aud": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^whombat-relay:[a-z0-9-]{1,32}$"
    },
    "rol": {
      "type": "string",
      "enum": [
        "client",
        "appliance"
      ]
    },
    "apl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "sub": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "org": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "wrk": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "chn": {
      "type": "string",
      "enum": [
        "app",
        "enroll"
      ]
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "nbf": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "jti": {
      "type": "string",
      "minLength": 22,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "lbl": {
      "type": "string",
      "minLength": 11,
      "maxLength": 32,
      "pattern": "^[a-z]{3,10}-[a-z]{3,10}-[a-z]{3,10}$"
    }
  },
  "required": [
    "iss",
    "aud",
    "rol",
    "apl",
    "sub",
    "wrk",
    "chn",
    "iat",
    "nbf",
    "exp",
    "jti"
  ],
  "additionalProperties": false
}
