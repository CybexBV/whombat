{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/RuntimeTicketResponse.json",
  "title": "RuntimeTicketResponse",
  "type": "object",
  "properties": {
    "ticket": {
      "type": "string",
      "minLength": 16,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9_-]+[.][A-Za-z0-9_-]+[.][A-Za-z0-9_-]+$"
    },
    "relayUrl": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256,
      "pattern": "^(wss|ws):[/][/][\\x21-\\x7e]+$"
    },
    "worker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "expiresAt": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "required": [
    "ticket",
    "relayUrl",
    "worker",
    "expiresAt"
  ]
}
