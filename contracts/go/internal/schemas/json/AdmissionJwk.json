{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/AdmissionJwk.json",
  "title": "AdmissionJwk",
  "type": "object",
  "properties": {
    "kty": {
      "type": "string",
      "const": "OKP"
    },
    "crv": {
      "type": "string",
      "const": "Ed25519"
    },
    "kid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "x": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "alg": {
      "type": "string",
      "const": "EdDSA"
    },
    "use": {
      "type": "string",
      "const": "sig"
    }
  },
  "required": [
    "kty",
    "crv",
    "kid",
    "x"
  ],
  "additionalProperties": false
}
