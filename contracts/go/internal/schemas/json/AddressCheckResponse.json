{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/AddressCheckResponse.json",
  "title": "AddressCheckResponse",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9-]+$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "free",
        "yours",
        "taken",
        "reserved",
        "invalid"
      ]
    }
  },
  "required": [
    "label",
    "verdict"
  ]
}
