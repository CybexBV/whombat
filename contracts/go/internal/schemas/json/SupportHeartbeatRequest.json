{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/SupportHeartbeatRequest.json",
  "title": "SupportHeartbeatRequest",
  "type": "object",
  "properties": {
    "support": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "off",
            "look",
            "fix"
          ]
        },
        "untilS": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 604800
            },
            {
              "type": "null"
            }
          ]
        },
        "connected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "helpCode": {
          "type": "boolean"
        },
        "hostKey": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI[A-Za-z0-9+/]{43}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "untilS",
        "connected",
        "helpCode",
        "hostKey"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "support"
  ],
  "additionalProperties": false
}
