{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/FeedbackDropsPullResponse.json",
  "title": "FeedbackDropsPullResponse",
  "type": "object",
  "properties": {
    "drops": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dropId": {
            "type": "string",
            "pattern": "^fdr_[A-Za-z0-9_-]{22}$"
          },
          "site": {
            "type": "string",
            "pattern": "^fbs_[A-Za-z0-9]{24}$"
          },
          "receivedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444800
          },
          "origin": {
            "type": "string",
            "minLength": 8,
            "maxLength": 255,
            "pattern": "^https?:[/][/][\\x21-\\x7e]+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 33817138
          },
          "envelope": {
            "type": "string",
            "minLength": 2,
            "maxLength": 45089518,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "reporter": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^fbr_[A-Za-z0-9_-]{22}$"
              },
              "emailDigest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "emailDigest"
            ]
          }
        },
        "required": [
          "dropId",
          "site",
          "receivedAt",
          "origin",
          "bytes",
          "envelope"
        ]
      }
    },
    "pending": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "expired": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "site": {
            "type": "string",
            "pattern": "^fbs_[A-Za-z0-9]{24}$"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        },
        "required": [
          "site",
          "count"
        ]
      }
    },
    "nextPullS": {
      "type": "integer",
      "minimum": 2,
      "maximum": 3600
    }
  },
  "required": [
    "drops",
    "pending",
    "expired",
    "nextPullS"
  ]
}
