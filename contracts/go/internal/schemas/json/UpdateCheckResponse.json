{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/UpdateCheckResponse.json",
  "title": "UpdateCheckResponse",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "result": {
      "type": "string",
      "enum": [
        "assigned",
        "unchanged",
        "none"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "started",
        "queued",
        "noop",
        "hold",
        "refused"
      ]
    },
    "nextCheckS": {
      "type": "integer",
      "minimum": 0,
      "maximum": 604800
    }
  },
  "required": [
    "v",
    "result",
    "nextCheckS"
  ]
}
