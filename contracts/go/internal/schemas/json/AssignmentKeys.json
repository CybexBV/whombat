{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/AssignmentKeys.json",
  "title": "AssignmentKeys",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "env": {
      "type": "string",
      "enum": [
        "local",
        "dev",
        "prod"
      ]
    },
    "keys": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "publicKey": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "next",
              "retired"
            ]
          },
          "notBefore": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 4102444800
              },
              {
                "type": "null"
              }
            ]
          },
          "notAfter": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 4102444800
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kid",
          "publicKey",
          "state",
          "notBefore",
          "notAfter"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "v",
    "env",
    "keys"
  ],
  "additionalProperties": false
}
