{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/DeviceRegistration.json",
  "title": "DeviceRegistration",
  "type": "object",
  "properties": {
    "env": {
      "type": "string",
      "enum": [
        "local",
        "dev",
        "prod"
      ]
    },
    "hardwareSerial": {
      "type": "string",
      "minLength": 4,
      "maxLength": 64,
      "pattern": "^[A-Z0-9-]+$"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "managementPublicKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contentPeerId": {
      "type": "string",
      "pattern": "^12D3KooW[1-9A-HJ-NP-Za-km-z]{44}$"
    },
    "contentPublicKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provisionedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "proof": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "contentProof": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "required": [
    "env",
    "hardwareSerial",
    "model",
    "managementPublicKey",
    "contentPeerId",
    "contentPublicKey",
    "provisionedAt",
    "proof",
    "contentProof"
  ],
  "additionalProperties": false
}
