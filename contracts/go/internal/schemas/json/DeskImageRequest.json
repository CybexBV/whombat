{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/DeskImageRequest.json",
  "title": "DeskImageRequest",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "thing": {
      "type": "string",
      "pattern": "^(server|connection|device|widget|account):[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "ref": {
      "type": "string",
      "minLength": 16,
      "maxLength": 600,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "v",
    "thing",
    "ref"
  ],
  "additionalProperties": false
}
