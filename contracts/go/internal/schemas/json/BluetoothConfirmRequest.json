{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/BluetoothConfirmRequest.json",
  "title": "BluetoothConfirmRequest",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "pairingId": {
      "type": "string",
      "pattern": "^p-[a-z0-9]{8,32}$"
    },
    "accept": {
      "type": "boolean"
    }
  },
  "required": [
    "v",
    "pairingId",
    "accept"
  ],
  "additionalProperties": false
}
