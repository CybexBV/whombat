{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/DeskTalkRequest.json",
  "title": "DeskTalkRequest",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "text": {
      "type": "string",
      "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,1000}$"
    },
    "audioWav": {
      "type": "string",
      "minLength": 60,
      "maxLength": 1280060,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    },
    "continue": {
      "type": "boolean"
    },
    "server": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "spoken": {
      "type": "boolean"
    }
  },
  "required": [
    "v",
    "continue"
  ],
  "additionalProperties": false
}
