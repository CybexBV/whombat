{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/ClaimLookupResponse.json",
  "title": "ClaimLookupResponse",
  "type": "object",
  "properties": {
    "lookup": {
      "type": "string",
      "pattern": "^[0-9]{4,6}$"
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "renewAfterS": {
      "type": "integer",
      "minimum": 30,
      "maximum": 86400
    }
  },
  "required": [
    "lookup",
    "expiresAt",
    "renewAfterS"
  ]
}
