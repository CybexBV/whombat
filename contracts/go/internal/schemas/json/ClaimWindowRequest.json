{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/ClaimWindowRequest.json",
  "title": "ClaimWindowRequest",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "required": {
      "type": "boolean"
    },
    "openUntil": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "v",
    "required",
    "openUntil"
  ],
  "additionalProperties": false
}
