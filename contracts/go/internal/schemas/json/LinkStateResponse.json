{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/LinkStateResponse.json",
  "title": "LinkStateResponse",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "link": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "off",
            "starting",
            "on",
            "grace",
            "ended"
          ]
        },
        "since": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "pending": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[ABCDEFGHJKMNPQRTVWXY]{4}-[ABCDEFGHJKMNPQRTVWXY]{4}$"
            },
            "url": {
              "type": "string",
              "minLength": 12,
              "maxLength": 256,
              "pattern": "^https:[/][/][\\x21-\\x7e]+$"
            },
            "expiresAt": {
              "type": "string",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          },
          "required": [
            "code",
            "url",
            "expiresAt"
          ]
        },
        "waitingForAddress": {
          "type": "boolean"
        },
        "graceEndsAt": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "trialEndsAt": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "label": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-z](-?[a-z0-9])+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254,
          "pattern": "^[\\x21-\\x3f\\x41-\\x7e]+@[\\x21-\\x3f\\x41-\\x7e]+$"
        },
        "checkedAt": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "required": [
        "state",
        "since"
      ]
    }
  },
  "required": [
    "v",
    "enabled",
    "link"
  ]
}
