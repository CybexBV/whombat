{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/DeskWifiScanAnswer.json",
  "title": "DeskWifiScanAnswer",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "scan": {
      "type": "object",
      "properties": {
        "networks": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ssid": {
                "type": "string",
                "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,32}$"
              },
              "security": {
                "type": "string",
                "enum": [
                  "open",
                  "psk",
                  "enterprise",
                  "other"
                ]
              },
              "signal": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "saved": {
                "type": "boolean"
              },
              "connected": {
                "type": "boolean"
              }
            },
            "required": [
              "ssid",
              "security",
              "signal",
              "saved",
              "connected"
            ]
          }
        },
        "scannedAt": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "required": [
        "networks",
        "scannedAt"
      ]
    }
  },
  "required": [
    "v",
    "scan"
  ]
}
