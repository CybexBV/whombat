{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/DeskSizeRequest.json",
  "title": "DeskSizeRequest",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "outputs": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,40}$"
          },
          "main": {
            "type": "boolean"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,60}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "size": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 200,
                "maximum": 16384
              },
              "height": {
                "type": "integer",
                "minimum": 200,
                "maximum": 16384
              }
            },
            "required": [
              "width",
              "height"
            ]
          }
        },
        "required": [
          "key",
          "main",
          "name",
          "size"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "v",
    "outputs"
  ],
  "additionalProperties": false
}
