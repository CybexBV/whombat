{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/NativePushRegistration.json",
  "title": "NativePushRegistration",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "apns",
        "fcm"
      ]
    },
    "token": {
      "type": "string",
      "minLength": 16,
      "maxLength": 4096,
      "pattern": "^[\\x21-\\x7e]+$"
    },
    "appId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._:-]+$"
    }
  },
  "required": [
    "platform",
    "token",
    "appId"
  ],
  "additionalProperties": false
}
