{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/LinkMailSetRequest.json",
  "title": "LinkMailSetRequest",
  "type": "object",
  "properties": {
    "offline": {
      "type": "boolean"
    },
    "notifications": {
      "type": "boolean"
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z]{4})?(-([A-Za-z]{2}|[0-9]{3}))?$"
    }
  },
  "required": [
    "offline",
    "notifications"
  ],
  "additionalProperties": false
}
