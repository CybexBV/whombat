{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/MaintenanceLockRequest.json",
  "title": "MaintenanceLockRequest",
  "type": "object",
  "properties": {
    "holder": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "ttlS": {
      "type": "integer",
      "minimum": 1,
      "maximum": 21600
    }
  },
  "required": [
    "holder",
    "reason",
    "ttlS"
  ],
  "additionalProperties": false
}
