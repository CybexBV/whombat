{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/SupportGrantRequest.json",
  "title": "SupportGrantRequest",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "level": {
      "type": "string",
      "enum": [
        "look",
        "fix"
      ]
    },
    "duration": {
      "type": "string",
      "enum": [
        "hour",
        "day",
        "week",
        "forever"
      ]
    },
    "grantedBy": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "pattern": "^acc_[A-Za-z0-9_-]{1,64}$",
          "description": "acc_ id"
        },
        "name": {
          "type": "string",
          "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,120}$"
        }
      },
      "required": [
        "accountId",
        "name"
      ]
    }
  },
  "required": [
    "v",
    "level",
    "duration",
    "grantedBy"
  ],
  "additionalProperties": false
}
