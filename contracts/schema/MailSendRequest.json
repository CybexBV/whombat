{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/MailSendRequest.json",
  "title": "MailSendRequest",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "waiting",
        "notice"
      ]
    },
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999
    },
    "cadence": {
      "type": "string",
      "enum": [
        "hourly",
        "daily"
      ]
    },
    "title": {
      "type": "string",
      "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,80}$"
    },
    "body": {
      "type": "string",
      "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,240}$"
    },
    "path": {
      "type": "string",
      "pattern": "^\\/[A-Za-z0-9/_.~%?&=-]{0,199}$"
    }
  },
  "required": [
    "kind",
    "ref"
  ],
  "additionalProperties": false
}
