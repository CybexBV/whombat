{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/NetworkCandidate.json",
  "title": "NetworkCandidate",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^n-[a-z0-9][a-z0-9-]{0,62}$"
    },
    "interface": {
      "type": "string",
      "pattern": "^(en|eth)[a-z0-9]{1,13}$"
    },
    "ipv4": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "dhcp",
            "static"
          ]
        },
        "address": {
          "type": "string",
          "pattern": "^[0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}[/][0-9]{1,2}$"
        },
        "gateway": {
          "type": "string",
          "pattern": "^[0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}$"
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "ipv6": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "static",
            "disabled"
          ]
        },
        "address": {
          "type": "string",
          "pattern": "^[0-9a-fA-F:]{2,39}[/][0-9]{1,3}$"
        },
        "gateway": {
          "type": "string",
          "pattern": "^[0-9a-fA-F:]{2,39}$"
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "dns": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F:.]{2,45}$"
      }
    },
    "mtu": {
      "type": "integer",
      "minimum": 576,
      "maximum": 9216
    },
    "confirmTimeoutSec": {
      "type": "integer",
      "minimum": 30,
      "maximum": 600
    }
  },
  "required": [
    "v",
    "id",
    "interface",
    "ipv4",
    "ipv6",
    "dns",
    "confirmTimeoutSec"
  ],
  "additionalProperties": false
}
