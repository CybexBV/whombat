{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/RuntimeFeedbackCardsResponse.json",
  "title": "RuntimeFeedbackCardsResponse",
  "type": "object",
  "properties": {
    "accepted": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^fbs_[A-Za-z0-9]{24}$"
      }
    },
    "refused": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 199
          },
          "site": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^fbs_[A-Za-z0-9]{24}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "bad_card",
              "too_large",
              "bad_signature",
              "expired",
              "site_bound_elsewhere",
              "stale_seq"
            ]
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "index",
          "site",
          "code"
        ]
      }
    }
  },
  "required": [
    "accepted",
    "refused"
  ]
}
