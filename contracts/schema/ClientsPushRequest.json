{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/ClientsPushRequest.json",
  "title": "ClientsPushRequest",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "clients": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "claude",
              "codex"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "not_installed",
              "installing",
              "installed",
              "updating",
              "failed"
            ]
          },
          "installed": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]*$"
                  },
                  "installedAt": {
                    "type": "string",
                    "maxLength": 40,
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                  },
                  "executable": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 255,
                        "pattern": "^[/][A-Za-z0-9_][A-Za-z0-9._+-]*([/][A-Za-z0-9_][A-Za-z0-9._+-]*)*$"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ]
                  },
                  "fixturesDigest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "version",
                  "installedAt",
                  "executable",
                  "fixturesDigest"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "latest": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]*$"
                  },
                  "publishedAt": {
                    "type": "string",
                    "maxLength": 40,
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                  }
                },
                "required": [
                  "version",
                  "publishedAt"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "progress": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 500,
                    "pattern": "^[\\x20-\\x7e]*$"
                  }
                },
                "required": [
                  "code",
                  "message"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "provider",
          "state",
          "installed",
          "latest",
          "progress",
          "error"
        ]
      }
    },
    "channel": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "checkedAt": {
              "type": "string",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          },
          "required": [
            "sequence",
            "checkedAt"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "v",
    "clients",
    "channel"
  ],
  "additionalProperties": false
}
