{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/AddressRenameResponse.json",
  "title": "AddressRenameResponse",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32,
      "pattern": "^[a-z](-?[a-z0-9])+$"
    },
    "host": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z](-?[a-z0-9])+[.]((box|dev)[.])?whombat[.]app$"
    },
    "registeredAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "leaving": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 3,
              "maxLength": 32,
              "pattern": "^[a-z](-?[a-z0-9])+$"
            },
            "host": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z](-?[a-z0-9])+[.]((box|dev)[.])?whombat[.]app$"
            },
            "until": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4102444800
            }
          },
          "required": [
            "label",
            "host",
            "until"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "label",
    "host",
    "registeredAt",
    "leaving"
  ]
}
