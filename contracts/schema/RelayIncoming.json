{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/RelayIncoming.json",
  "title": "RelayIncoming",
  "type": "object",
  "properties": {
    "t": {
      "type": "string",
      "const": "incoming"
    },
    "session": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "class": {
      "type": "string",
      "enum": [
        "interactive",
        "bulk",
        "web",
        "acme"
      ]
    },
    "src": {
      "type": "string",
      "maxLength": 39,
      "pattern": "^(((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])[.]){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|[0-9a-f]{0,4}(:[0-9a-f]{0,4}){2,7})$"
    }
  },
  "required": [
    "t",
    "session",
    "class"
  ]
}
