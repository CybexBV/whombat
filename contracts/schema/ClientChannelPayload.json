{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/ClientChannelPayload.json",
  "title": "ClientChannelPayload",
  "type": "object",
  "properties": {
    "purpose": {
      "type": "string",
      "const": "whombat-client-channel/v1"
    },
    "env": {
      "type": "string",
      "enum": [
        "local",
        "dev",
        "prod"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issuedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "bundles": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "claude",
              "codex"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]*$"
          },
          "os": {
            "type": "string",
            "enum": [
              "linux"
            ]
          },
          "arch": {
            "type": "string",
            "enum": [
              "x86_64",
              "aarch64"
            ]
          },
          "publishedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444800
          },
          "testedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444800
          },
          "fixturesDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "adapter": {
            "type": "object",
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "max": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              }
            },
            "required": [
              "min",
              "max"
            ],
            "additionalProperties": false
          },
          "artifact": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string",
                "maxLength": 120,
                "pattern": "^clients[/](claude|codex)[/][0-9A-Za-z][0-9A-Za-z.+_-]{0,63}[/]linux-(x86_64|aarch64)[.]tar[.]gz$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[A-Za-z0-9_][A-Za-z0-9._+-]*([/][A-Za-z0-9_][A-Za-z0-9._+-]*)*$"
              }
            },
            "required": [
              "target",
              "sha256",
              "size",
              "path"
            ],
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "minLength": 12,
                "maxLength": 500,
                "pattern": "^https:[/][/][\\x21-\\x7e]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "format": {
                "type": "string",
                "enum": [
                  "binary",
                  "tar.gz"
                ]
              },
              "path": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "pattern": "^[A-Za-z0-9_][A-Za-z0-9._+-]*([/][A-Za-z0-9_][A-Za-z0-9._+-]*)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "url",
              "sha256",
              "size",
              "format",
              "path"
            ],
            "additionalProperties": false
          },
          "executable": {
            "type": "object",
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            },
            "required": [
              "sha256",
              "size"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "provider",
          "version",
          "os",
          "arch",
          "publishedAt",
          "testedAt",
          "fixturesDigest",
          "adapter",
          "artifact",
          "source",
          "executable"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "purpose",
    "env",
    "sequence",
    "issuedAt",
    "expiresAt",
    "bundles"
  ],
  "additionalProperties": false
}
