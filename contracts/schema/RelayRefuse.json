{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/RelayRefuse.json",
  "title": "RelayRefuse",
  "type": "object",
  "properties": {
    "t": {
      "type": "string",
      "const": "refuse"
    },
    "session": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "t",
    "session"
  ]
}
