{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/DrainRequest.json",
  "title": "DrainRequest",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "update",
        "host-update",
        "network",
        "backup"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "all",
        "writes"
      ]
    },
    "releaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "leaseMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 3600000
    }
  },
  "required": [
    "v",
    "requestId",
    "reason",
    "scope",
    "leaseMs"
  ],
  "additionalProperties": false
}
