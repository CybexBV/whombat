{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/HostMetricsResponse.json",
  "title": "HostMetricsResponse",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "metrics": {
      "type": "object",
      "properties": {
        "now": {
          "type": "object",
          "properties": {
            "at": {
              "type": "string",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "cpuPermille": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "cores": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "memoryTotalBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "memoryUsedBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "containersMemoryBytes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "uplink": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 15,
                "pattern": "^[A-Za-z0-9_.:@-]+$"
              }
            },
            "power": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "enum": [
                    "ac",
                    "battery"
                  ]
                },
                "percent": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "charging": {
                  "type": "boolean"
                },
                "minutesLeft": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "chargeLimit": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "since": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 40,
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "source",
                "percent",
                "charging",
                "minutesLeft",
                "chargeLimit",
                "since"
              ]
            },
            "cpuTempC": {
              "type": "integer",
              "minimum": -50,
              "maximum": 150
            },
            "uptimeS": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000000
            }
          },
          "required": [
            "at",
            "cpuPermille",
            "cores",
            "memoryTotalBytes",
            "memoryUsedBytes",
            "containersMemoryBytes",
            "uplink"
          ]
        },
        "disks": {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "totalBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "usedBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "freeBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "parts": {
                  "anyOf": [
                    {
                      "maxItems": 4,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string",
                            "enum": [
                              "containers",
                              "whombat",
                              "work",
                              "database"
                            ]
                          },
                          "bytes": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "key",
                          "bytes"
                        ]
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "totalBytes",
                "usedBytes",
                "freeBytes",
                "parts"
              ]
            },
            "system": {
              "type": "object",
              "properties": {
                "totalBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "usedBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "freeBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "totalBytes",
                "usedBytes",
                "freeBytes"
              ]
            },
            "backup": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "totalBytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "usedBytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "freeBytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "totalBytes",
                    "usedBytes",
                    "freeBytes"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "data",
            "system",
            "backup"
          ]
        },
        "series": {
          "type": "object",
          "properties": {
            "range": {
              "type": "string",
              "enum": [
                "hour",
                "day",
                "week",
                "month"
              ]
            },
            "start": {
              "type": "string",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "stepS": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "points": {
              "maxItems": 400,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "cpuPermille": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000
                      },
                      "cpuPeakPermille": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000
                      },
                      "memoryUsedBytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "inBytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "outBytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "cpuPermille",
                      "cpuPeakPermille",
                      "memoryUsedBytes",
                      "inBytes",
                      "outBytes"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "required": [
            "range",
            "start",
            "stepS",
            "points"
          ]
        },
        "days": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "inBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "outBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "date",
              "inBytes",
              "outBytes"
            ]
          }
        },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_+./-]+$"
        },
        "measuringSince": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "required": [
        "now",
        "disks",
        "series",
        "days",
        "timeZone",
        "measuringSince"
      ]
    }
  },
  "required": [
    "v",
    "metrics"
  ]
}
