{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/PushSendResponse.json",
  "title": "PushSendResponse",
  "type": "object",
  "properties": {
    "accepted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "invalidHandles": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 22,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "rateLimited": {
      "type": "boolean"
    }
  },
  "required": [
    "accepted",
    "invalidHandles",
    "rateLimited"
  ]
}
