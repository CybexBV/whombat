{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/VoiceSttAnswer.json",
  "title": "VoiceSttAnswer",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "text": {
      "type": "string",
      "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){0,500}$"
    },
    "seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30
    }
  },
  "required": [
    "v",
    "text",
    "seconds"
  ]
}
