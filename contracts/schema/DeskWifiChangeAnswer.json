{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/DeskWifiChangeAnswer.json",
  "title": "DeskWifiChangeAnswer",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "change": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^c-[a-z0-9]{8,32}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "join",
            "forget"
          ]
        },
        "ssid": {
          "type": "string",
          "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,32}$"
        },
        "phase": {
          "type": "string",
          "enum": [
            "applying",
            "confirming",
            "committed",
            "reverting",
            "reverted",
            "failed"
          ]
        },
        "deadline": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "previous": {
          "type": "string",
          "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,32}$"
        },
        "failure": {
          "type": "string",
          "enum": [
            "wrong_password",
            "not_found",
            "no_address",
            "no_internet",
            "failed"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "ssid",
        "phase",
        "deadline"
      ]
    }
  },
  "required": [
    "v",
    "change"
  ]
}
