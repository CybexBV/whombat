{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/DeskServerPage.json",
  "title": "DeskServerPage",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "now": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "server": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,40}$"
        },
        "mark": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "state": {
          "type": "string",
          "enum": [
            "ok",
            "warn",
            "bad",
            "off"
          ]
        },
        "note": {
          "type": "string",
          "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){0,40}$"
        },
        "cpu": {
          "type": "object",
          "properties": {
            "value": {
              "type": "integer",
              "minimum": -100,
              "maximum": 1000
            },
            "tone": {
              "type": "string",
              "enum": [
                "ok",
                "warn",
                "bad"
              ]
            }
          },
          "required": [
            "value",
            "tone"
          ]
        },
        "memory": {
          "type": "object",
          "properties": {
            "value": {
              "type": "integer",
              "minimum": -100,
              "maximum": 1000
            },
            "tone": {
              "type": "string",
              "enum": [
                "ok",
                "warn",
                "bad"
              ]
            }
          },
          "required": [
            "value",
            "tone"
          ]
        },
        "temp": {
          "type": "object",
          "properties": {
            "value": {
              "type": "integer",
              "minimum": -100,
              "maximum": 1000
            },
            "tone": {
              "type": "string",
              "enum": [
                "ok",
                "warn",
                "bad"
              ]
            }
          },
          "required": [
            "value",
            "tone"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "disk": {
          "type": "object",
          "properties": {
            "value": {
              "type": "integer",
              "minimum": -100,
              "maximum": 1000
            },
            "tone": {
              "type": "string",
              "enum": [
                "ok",
                "warn",
                "bad"
              ]
            }
          },
          "required": [
            "value",
            "tone"
          ]
        }
      },
      "required": [
        "name",
        "mark",
        "state",
        "note"
      ]
    },
    "os": {
      "type": "string",
      "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){0,60}$"
    },
    "up": {
      "type": "string",
      "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){0,40}$"
    },
    "cpu": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "cores": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                },
                {
                  "type": "null"
                }
              ]
            },
            "load": {
              "type": "string",
              "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){0,8}$"
            },
            "tone": {
              "type": "string",
              "enum": [
                "ok",
                "warn",
                "bad"
              ]
            }
          },
          "required": [
            "percent",
            "cores",
            "load",
            "tone"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "memory": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "used": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,8}$"
                },
                "unit": {
                  "type": "string",
                  "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,8}$"
                }
              },
              "required": [
                "value",
                "unit"
              ]
            },
            "total": {
              "type": "string",
              "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,16}$"
            },
            "tone": {
              "type": "string",
              "enum": [
                "ok",
                "warn",
                "bad"
              ]
            }
          },
          "required": [
            "percent",
            "used",
            "total",
            "tone"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "disk": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "used": {
              "type": "string",
              "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,16}$"
            },
            "total": {
              "type": "string",
              "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,16}$"
            },
            "tone": {
              "type": "string",
              "enum": [
                "ok",
                "warn",
                "bad"
              ]
            }
          },
          "required": [
            "percent",
            "used",
            "total",
            "tone"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "temp": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "integer",
              "minimum": -100,
              "maximum": 1000
            },
            "limit": {
              "type": "integer",
              "minimum": -100,
              "maximum": 1000
            },
            "tone": {
              "type": "string",
              "enum": [
                "ok",
                "warn",
                "bad"
              ]
            }
          },
          "required": [
            "value",
            "limit",
            "tone"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "history": {
      "type": "object",
      "properties": {
        "range": {
          "type": "string",
          "enum": [
            "1h",
            "24h",
            "7d"
          ]
        },
        "stepS": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "cpu": {
          "maxItems": 96,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "memory": {
          "maxItems": 96,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "cpuPeak": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "percent": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "at": {
                  "type": "string",
                  "maxLength": 40,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                }
              },
              "required": [
                "percent",
                "at"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "memoryAvg": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "range",
        "stepS",
        "cpu",
        "memory",
        "cpuPeak",
        "memoryAvg"
      ]
    },
    "volumes": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,40}$"
          },
          "note": {
            "type": "string",
            "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){0,40}$"
          },
          "percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "used": {
            "type": "string",
            "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,16}$"
          },
          "total": {
            "type": "string",
            "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,16}$"
          },
          "tone": {
            "type": "string",
            "enum": [
              "ok",
              "warn",
              "bad"
            ]
          }
        },
        "required": [
          "name",
          "note",
          "percent",
          "used",
          "total",
          "tone"
        ]
      }
    },
    "guests": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "running": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "off": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "items": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,60}$"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "vm",
                      "container"
                    ]
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "running",
                      "stopped",
                      "unhealthy",
                      "paused"
                    ]
                  },
                  "cpu": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "memory": {
                    "type": "string",
                    "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){0,16}$"
                  }
                },
                "required": [
                  "name",
                  "kind",
                  "state",
                  "cpu",
                  "memory"
                ]
              }
            }
          },
          "required": [
            "running",
            "off",
            "items"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "network": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "down": {
              "type": "string",
              "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,16}$"
            },
            "up": {
              "type": "string",
              "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,16}$"
            }
          },
          "required": [
            "down",
            "up"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "alerts": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "items": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tone": {
                "type": "string",
                "enum": [
                  "warn",
                  "bad"
                ]
              },
              "title": {
                "type": "string",
                "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,120}$"
              }
            },
            "required": [
              "tone",
              "title"
            ]
          }
        }
      },
      "required": [
        "count",
        "items"
      ]
    }
  },
  "required": [
    "v",
    "now",
    "server",
    "os",
    "up",
    "cpu",
    "memory",
    "disk",
    "temp",
    "history",
    "volumes",
    "guests",
    "network",
    "alerts"
  ]
}
