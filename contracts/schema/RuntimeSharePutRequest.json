{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/RuntimeSharePutRequest.json",
  "title": "RuntimeSharePutRequest",
  "type": "object",
  "properties": {
    "shareId": {
      "type": "string",
      "pattern": "^shr_[A-Za-z0-9_-]{22}$"
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "envelope": {
      "type": "string",
      "minLength": 2,
      "maxLength": 11184811,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "shareId",
    "envelope"
  ],
  "additionalProperties": false
}
