{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/RelayRenewed.json",
  "title": "RelayRenewed",
  "type": "object",
  "properties": {
    "t": {
      "type": "string",
      "const": "renewed"
    },
    "lease": {
      "type": "object",
      "properties": {
        "renewWithinS": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      },
      "required": [
        "renewWithinS"
      ]
    }
  },
  "required": [
    "t",
    "lease"
  ]
}
