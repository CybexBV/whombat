{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/LinkWhombatsResponse.json",
  "title": "LinkWhombatsResponse",
  "type": "object",
  "properties": {
    "whombats": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,80}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "off",
              "starting",
              "on",
              "grace",
              "ended"
            ]
          },
          "host": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z](-?[a-z0-9])+[.]((box|dev)[.])?whombat[.]app$"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastSeenAt": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 4102444800
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "device",
          "name",
          "state",
          "host",
          "lastSeenAt"
        ]
      }
    }
  },
  "required": [
    "whombats"
  ]
}
