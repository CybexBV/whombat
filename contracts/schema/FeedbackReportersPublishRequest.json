{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/FeedbackReportersPublishRequest.json",
  "title": "FeedbackReportersPublishRequest",
  "type": "object",
  "properties": {
    "updates": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "site": {
            "type": "string",
            "pattern": "^fbs_[A-Za-z0-9]{24}$"
          },
          "reporterId": {
            "type": "string",
            "pattern": "^fbr_[A-Za-z0-9_-]{22}$"
          },
          "reference": {
            "type": "string",
            "pattern": "^FB-[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{4}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "bug",
              "feature"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "received",
              "reviewing",
              "needs_info",
              "confirmed",
              "in_progress",
              "fixed",
              "closed"
            ]
          },
          "receivedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444800
          },
          "updatedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444800
          }
        },
        "required": [
          "site",
          "reporterId",
          "reference",
          "type",
          "status",
          "receivedAt",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    },
    "removals": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "site": {
            "type": "string",
            "pattern": "^fbs_[A-Za-z0-9]{24}$"
          },
          "reference": {
            "type": "string",
            "pattern": "^FB-[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{4}$"
          }
        },
        "required": [
          "site",
          "reference"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "updates",
    "removals"
  ],
  "additionalProperties": false
}
