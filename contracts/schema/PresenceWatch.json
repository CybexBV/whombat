{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/PresenceWatch.json",
  "title": "PresenceWatch",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "starting",
        "watching",
        "dark",
        "failed",
        "no_camera"
      ]
    },
    "face": {
      "type": "boolean"
    },
    "seenAt": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "frameAt": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "required": [
    "v",
    "state",
    "face"
  ]
}
