{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/TeamReportsListResponse.json",
  "title": "TeamReportsListResponse",
  "type": "object",
  "properties": {
    "available": {
      "type": "boolean"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "not_invited",
            "off",
            "link_off"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "reports": {
      "type": "string",
      "minLength": 2,
      "maxLength": 5592406,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "available",
    "reason",
    "reports"
  ]
}
