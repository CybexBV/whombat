{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/RuntimeKitEnvelopesRequest.json",
  "title": "RuntimeKitEnvelopesRequest",
  "type": "object",
  "properties": {
    "envelopes": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "credentialId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "salt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "envelope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536,
            "pattern": "^wbkit1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
          },
          "generation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "required": [
          "credentialId",
          "salt",
          "envelope",
          "generation"
        ],
        "additionalProperties": false
      }
    },
    "adoptedFrom": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9-]+$"
    },
    "applianceName": {
      "type": "string",
      "pattern": "^[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}](?:(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){0,78}[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}])?$"
    }
  },
  "required": [
    "envelopes"
  ],
  "additionalProperties": false
}
