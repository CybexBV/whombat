{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/DeskBluetoothPairingAnswer.json",
  "title": "DeskBluetoothPairingAnswer",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "pairing": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^p-[a-z0-9]{8,32}$"
        },
        "address": {
          "type": "string",
          "pattern": "^[0-9A-F]{2}(:[0-9A-F]{2}){5}$"
        },
        "name": {
          "type": "string",
          "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,80}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "keyboard",
            "mouse",
            "headphones",
            "headset",
            "speaker",
            "gamepad",
            "other"
          ]
        },
        "phase": {
          "type": "string",
          "enum": [
            "pairing",
            "code",
            "confirm",
            "connecting",
            "done",
            "failed"
          ]
        },
        "deadline": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "code": {
          "type": "string",
          "pattern": "^[0-9]{4,6}$"
        },
        "typed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "failure": {
          "type": "string",
          "enum": [
            "rejected",
            "timeout",
            "not_found",
            "canceled",
            "failed"
          ]
        }
      },
      "required": [
        "id",
        "address",
        "name",
        "kind",
        "phase",
        "deadline"
      ]
    }
  },
  "required": [
    "v",
    "pairing"
  ]
}
