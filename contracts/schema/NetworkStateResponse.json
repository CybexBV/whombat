{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/NetworkStateResponse.json",
  "title": "NetworkStateResponse",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "network": {
      "type": "object",
      "properties": {
        "online": {
          "type": "boolean"
        },
        "checkedAt": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "wired": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "interface": {
                "type": "string",
                "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,15}$"
              },
              "connected": {
                "type": "boolean"
              },
              "address": {
                "type": "string",
                "pattern": "^[0-9A-Fa-f:.]{2,45}$"
              },
              "plugged": {
                "type": "boolean"
              },
              "mac": {
                "type": "string",
                "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
              },
              "prefixLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 128
              }
            },
            "required": [
              "interface",
              "connected"
            ]
          }
        },
        "wifi": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "interface": {
                  "type": "string",
                  "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,15}$"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "disconnected",
                    "connecting",
                    "connected"
                  ]
                },
                "ssid": {
                  "type": "string",
                  "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,32}$"
                },
                "signal": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4
                },
                "address": {
                  "type": "string",
                  "pattern": "^[0-9A-Fa-f:.]{2,45}$"
                },
                "saved": {
                  "maxItems": 32,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ssid": {
                        "type": "string",
                        "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,32}$"
                      },
                      "security": {
                        "type": "string",
                        "enum": [
                          "open",
                          "psk",
                          "enterprise",
                          "other"
                        ]
                      }
                    },
                    "required": [
                      "ssid",
                      "security"
                    ]
                  }
                },
                "mac": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
                },
                "prefixLength": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 128
                }
              },
              "required": [
                "interface",
                "state",
                "saved"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "wifiMissing": {
          "type": "string",
          "enum": [
            "no_adapter",
            "no_driver",
            "disabled"
          ]
        },
        "change": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^c-[a-z0-9]{8,32}$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "join",
                    "forget"
                  ]
                },
                "ssid": {
                  "type": "string",
                  "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,32}$"
                },
                "phase": {
                  "type": "string",
                  "enum": [
                    "applying",
                    "confirming",
                    "committed",
                    "reverting",
                    "reverted",
                    "failed"
                  ]
                },
                "deadline": {
                  "type": "string",
                  "maxLength": 40,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                "previous": {
                  "type": "string",
                  "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,32}$"
                },
                "failure": {
                  "type": "string",
                  "enum": [
                    "wrong_password",
                    "not_found",
                    "no_address",
                    "no_internet",
                    "failed"
                  ]
                }
              },
              "required": [
                "id",
                "kind",
                "ssid",
                "phase",
                "deadline"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "wifiOnly": {
          "type": "boolean"
        },
        "cableChange": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^c-[a-z0-9]{8,32}$"
            },
            "use": {
              "type": "string",
              "enum": [
                "wifi",
                "cable"
              ]
            },
            "by": {
              "type": "string",
              "enum": [
                "person",
                "backup"
              ]
            },
            "phase": {
              "type": "string",
              "enum": [
                "applying",
                "confirming",
                "committed",
                "reverting",
                "reverted",
                "failed"
              ]
            },
            "deadline": {
              "type": "string",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "failure": {
              "type": "string",
              "enum": [
                "wrong_password",
                "not_found",
                "no_address",
                "no_internet",
                "failed"
              ]
            }
          },
          "required": [
            "id",
            "use",
            "by",
            "phase",
            "deadline"
          ]
        }
      },
      "required": [
        "online",
        "checkedAt",
        "wired",
        "wifi",
        "change"
      ]
    }
  },
  "required": [
    "v",
    "network"
  ]
}
