{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/KitCredentialsDeclareRequest.json",
  "title": "KitCredentialsDeclareRequest",
  "type": "object",
  "properties": {
    "credentialIds": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    }
  },
  "required": [
    "credentialIds"
  ],
  "additionalProperties": false
}
