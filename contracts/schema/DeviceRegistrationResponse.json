{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/DeviceRegistrationResponse.json",
  "title": "DeviceRegistrationResponse",
  "type": "object",
  "properties": {
    "device": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "applianceRoute": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "env": {
      "type": "string",
      "enum": [
        "local",
        "dev",
        "prod"
      ]
    }
  },
  "required": [
    "device",
    "applianceRoute",
    "env"
  ]
}
