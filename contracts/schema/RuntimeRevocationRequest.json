{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/RuntimeRevocationRequest.json",
  "title": "RuntimeRevocationRequest",
  "type": "object",
  "properties": {
    "peerId": {
      "type": "string",
      "pattern": "^12D3KooW[1-9A-HJ-NP-Za-km-z]{44}$"
    },
    "revokedAt": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "required": [
    "peerId",
    "revokedAt"
  ],
  "additionalProperties": false
}
