{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/RuntimeKitEnvelopesResponse.json",
  "title": "RuntimeKitEnvelopesResponse",
  "type": "object",
  "properties": {
    "stored": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "skipped": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "skippedCredentialIds": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    }
  },
  "required": [
    "stored",
    "skipped"
  ]
}
