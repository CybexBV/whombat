{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/DeviceRequestEnvelope.json",
  "title": "DeviceRequestEnvelope",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "aud": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^whombat-api:[a-z0-9-]{1,32}$"
    },
    "device": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "op": {
      "type": "string",
      "enum": [
        "ticket.issue",
        "claim.claimed",
        "claim.lookup",
        "status.report",
        "revocations.report",
        "push.send",
        "update.assignment",
        "update.progress",
        "licence.renew",
        "feedback.cards.sync",
        "feedback.drops.pull",
        "feedback.drops.ack",
        "feedback.reporters.publish",
        "support.ticket",
        "kit.envelopes.put",
        "share.put",
        "share.delete",
        "share.views",
        "address.register",
        "account.link.lookup",
        "account.link",
        "kit.credentials.declare",
        "link.begin",
        "link.status",
        "link.leave",
        "link.whombats",
        "push.register",
        "push.unregister",
        "support.heartbeat"
      ]
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "body": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "sig": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "required": [
    "v",
    "aud",
    "device",
    "op",
    "ts",
    "nonce",
    "body",
    "sig"
  ],
  "additionalProperties": false
}
