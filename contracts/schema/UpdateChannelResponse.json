{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/UpdateChannelResponse.json",
  "title": "UpdateChannelResponse",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "channel": {
      "type": "string",
      "enum": [
        "production",
        "development"
      ]
    },
    "staysOn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    }
  },
  "required": [
    "v",
    "channel"
  ]
}
