{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/VoiceTranscribeAnswer.json",
  "title": "VoiceTranscribeAnswer",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "parts": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){0,1000}$"
      }
    },
    "seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300
    },
    "model": {
      "type": "string",
      "enum": [
        "parakeet",
        "whisper"
      ]
    },
    "gpu": {
      "type": "boolean"
    }
  },
  "required": [
    "v",
    "parts",
    "seconds",
    "model",
    "gpu"
  ]
}
