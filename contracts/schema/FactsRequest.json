{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/FactsRequest.json",
  "title": "FactsRequest",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "backup": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "whombat.backup-status/1"
            },
            "state": {
              "type": "string",
              "enum": [
                "unprotected",
                "pending",
                "protected",
                "stale",
                "failing"
              ]
            },
            "protected": {
              "type": "boolean"
            },
            "destination": {
              "type": "object",
              "properties": {
                "configured": {
                  "type": "boolean"
                },
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "display": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 200,
                  "pattern": "^[\\x20-\\x7e]*$"
                },
                "appendOnly": {
                  "type": "string",
                  "enum": [
                    "verified",
                    "not-enforced",
                    "unknown"
                  ]
                },
                "repositoryId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                }
              },
              "required": [
                "configured"
              ]
            },
            "lastSuccess": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "at": {
                      "type": "string",
                      "maxLength": 40,
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                    },
                    "ageSeconds": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "snapshotId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "method": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "quiesceHeldMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "durationMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "bytesAdded": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "totalBytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "files": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "schemaVersion": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "incomplete": {
                      "type": "object",
                      "properties": {
                        "attachments": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "servers": {
                          "type": "boolean"
                        },
                        "reason": {
                          "type": "string",
                          "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){0,500}$"
                        }
                      },
                      "required": [
                        "reason"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "at",
                    "ageSeconds",
                    "snapshotId",
                    "method",
                    "quiesceHeldMs",
                    "durationMs",
                    "bytesAdded",
                    "totalBytes",
                    "files",
                    "schemaVersion"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "lastFailure": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "at": {
                      "type": "string",
                      "maxLength": 40,
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                    },
                    "stage": {
                      "type": "string",
                      "enum": [
                        "preflight",
                        "quiesce",
                        "snapshot",
                        "dump",
                        "upload",
                        "verify"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){0,500}$"
                    }
                  },
                  "required": [
                    "id",
                    "at",
                    "stage",
                    "reason"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "lastAttemptOk": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "failedAttempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "coverage": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^[\\x20-\\x7e]*$"
                  },
                  "covered": {
                    "type": "boolean"
                  },
                  "relogin": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "title",
                  "covered"
                ]
              }
            },
            "recoverability": {
              "type": "object",
              "properties": {
                "lastDrill": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "at": {
                          "type": "string",
                          "maxLength": 40,
                          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                        },
                        "ok": {
                          "type": "boolean"
                        },
                        "checkpointId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64,
                          "pattern": "^[A-Za-z0-9_.:-]+$"
                        },
                        "rtoSeconds": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "backupAgeSeconds": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "failed": {
                          "maxItems": 32,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 32,
                            "pattern": "^[A-Za-z0-9_.:-]+$"
                          }
                        },
                        "skipped": {
                          "maxItems": 32,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 32,
                            "pattern": "^[A-Za-z0-9_.:-]+$"
                          }
                        }
                      },
                      "required": [
                        "at",
                        "ok",
                        "checkpointId",
                        "rtoSeconds",
                        "backupAgeSeconds"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "lastDrill"
              ]
            },
            "kitGeneration": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "running": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "op": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "stage": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "since": {
                      "type": "string",
                      "maxLength": 40,
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                    }
                  },
                  "required": [
                    "id",
                    "op",
                    "stage",
                    "since"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "clearing": {
              "type": "object",
              "properties": {
                "by": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "at": {
                  "type": "string",
                  "maxLength": 40,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                "ok": {
                  "type": "boolean"
                },
                "error": {
                  "type": "string",
                  "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){0,500}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "overLimit": {
                  "type": "boolean"
                }
              },
              "required": [
                "by"
              ]
            },
            "updatedAt": {
              "type": "string",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          },
          "required": [
            "kind",
            "state",
            "protected",
            "destination",
            "lastSuccess",
            "lastFailure",
            "lastAttemptOk",
            "coverage",
            "recoverability",
            "kitGeneration",
            "running",
            "updatedAt"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "update": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "Assigned",
                "Downloading",
                "Verified",
                "Staged",
                "WaitingForSafeBoundary",
                "Activating",
                "Verifying",
                "Healthy",
                "Failed",
                "RolledBack",
                "Quarantined",
                "ForwardRepairRequired"
              ]
            },
            "current": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "candidate": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "lastCheckedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 40,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "deferredReason": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "failure": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "clientFloor": {
              "type": "object",
              "properties": {
                "web": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "android": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "ios": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "desktop": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "cli": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                }
              },
              "required": [
                "web",
                "android",
                "ios",
                "desktop",
                "cli"
              ],
              "additionalProperties": false
            },
            "failureDetail": {
              "type": "object",
              "properties": {
                "stage": {
                  "type": "string",
                  "enum": [
                    "Assigned",
                    "Downloading",
                    "Verified",
                    "Staged",
                    "WaitingForSafeBoundary",
                    "Activating",
                    "Verifying",
                    "Healthy",
                    "Failed",
                    "RolledBack",
                    "Quarantined",
                    "ForwardRepairRequired"
                  ]
                },
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "reasons": {
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  }
                },
                "release": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 80,
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "database": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "target": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "candidateWrites": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "candidateReads": {
                      "type": "object",
                      "properties": {
                        "min": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000
                        },
                        "max": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000
                        }
                      },
                      "required": [
                        "min",
                        "max"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "database",
                    "target",
                    "candidateWrites",
                    "candidateReads"
                  ]
                },
                "rollbackAccess": {
                  "type": "string",
                  "enum": [
                    "read-write",
                    "read-only",
                    "none"
                  ]
                },
                "failedChecks": {
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "runtime",
                      "database",
                      "session_endpoint",
                      "runner",
                      "relay_control",
                      "boot",
                      "manager"
                    ]
                  }
                },
                "at": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4102444800
                }
              },
              "required": [
                "stage",
                "code",
                "reasons",
                "release",
                "failedChecks",
                "at"
              ]
            },
            "waiting": {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string",
                  "enum": [
                    "boundary",
                    "checkpoint",
                    "window",
                    "hold",
                    "lock",
                    "metadata",
                    "owner"
                  ]
                },
                "since": {
                  "type": "string",
                  "maxLength": 40,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                "blockers": {
                  "maxItems": 16,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[A-Za-z0-9_.:-]+$"
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      }
                    },
                    "required": [
                      "kind",
                      "count"
                    ]
                  }
                }
              },
              "required": [
                "reason",
                "since",
                "blockers"
              ]
            },
            "lastUpdate": {
              "type": "object",
              "properties": {
                "release": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 80,
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "from": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 80,
                      "pattern": "^[a-z0-9][a-z0-9._-]*$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "at": {
                  "type": "string",
                  "maxLength": 40,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                }
              },
              "required": [
                "release",
                "from",
                "at"
              ]
            },
            "askFirst": {
              "type": "boolean"
            },
            "paused": {
              "type": "boolean"
            }
          },
          "required": [
            "state",
            "current",
            "candidate",
            "lastCheckedAt",
            "deferredReason",
            "failure"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "v",
    "backup",
    "update"
  ],
  "additionalProperties": false
}
