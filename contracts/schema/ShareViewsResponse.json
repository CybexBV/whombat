{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/ShareViewsResponse.json",
  "title": "ShareViewsResponse",
  "type": "object",
  "properties": {
    "shares": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shareId": {
            "type": "string",
            "pattern": "^shr_[A-Za-z0-9_-]{22}$"
          },
          "views": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "lastViewedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444800
          }
        },
        "required": [
          "shareId",
          "views"
        ]
      }
    }
  },
  "required": [
    "shares"
  ]
}
