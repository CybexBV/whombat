{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/UpdateAssignmentRequest.json",
  "title": "UpdateAssignmentRequest",
  "type": "object",
  "properties": {
    "current": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "lastSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "current",
    "lastSequence"
  ],
  "additionalProperties": false
}
