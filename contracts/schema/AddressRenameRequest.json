{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/AddressRenameRequest.json",
  "title": "AddressRenameRequest",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32,
      "pattern": "^[a-z](-?[a-z0-9])+$"
    },
    "move": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "label"
  ],
  "additionalProperties": false
}
