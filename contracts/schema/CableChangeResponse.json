{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/CableChangeResponse.json",
  "title": "CableChangeResponse",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "change": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^c-[a-z0-9]{8,32}$"
        },
        "use": {
          "type": "string",
          "enum": [
            "wifi",
            "cable"
          ]
        },
        "by": {
          "type": "string",
          "enum": [
            "person",
            "backup"
          ]
        },
        "phase": {
          "type": "string",
          "enum": [
            "applying",
            "confirming",
            "committed",
            "reverting",
            "reverted",
            "failed"
          ]
        },
        "deadline": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "failure": {
          "type": "string",
          "enum": [
            "wrong_password",
            "not_found",
            "no_address",
            "no_internet",
            "failed"
          ]
        }
      },
      "required": [
        "id",
        "use",
        "by",
        "phase",
        "deadline"
      ]
    }
  },
  "required": [
    "v",
    "change"
  ]
}
