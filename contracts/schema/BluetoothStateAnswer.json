{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/BluetoothStateAnswer.json",
  "title": "BluetoothStateAnswer",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "bluetooth": {
      "type": "object",
      "properties": {
        "adapter": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,80}$"
                },
                "powered": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "powered"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "missing": {
          "type": "string",
          "enum": [
            "no_adapter",
            "no_driver",
            "disabled"
          ]
        },
        "devices": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string",
                "pattern": "^[0-9A-F]{2}(:[0-9A-F]{2}){5}$"
              },
              "name": {
                "type": "string",
                "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,80}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "keyboard",
                  "mouse",
                  "headphones",
                  "headset",
                  "speaker",
                  "gamepad",
                  "other"
                ]
              },
              "connected": {
                "type": "boolean"
              },
              "battery": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "signal": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              }
            },
            "required": [
              "address",
              "name",
              "kind",
              "connected"
            ]
          }
        },
        "scan": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "until": {
                  "type": "string",
                  "maxLength": 40,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                "devices": {
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "address": {
                        "type": "string",
                        "pattern": "^[0-9A-F]{2}(:[0-9A-F]{2}){5}$"
                      },
                      "name": {
                        "type": "string",
                        "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,80}$"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "keyboard",
                          "mouse",
                          "headphones",
                          "headset",
                          "speaker",
                          "gamepad",
                          "other"
                        ]
                      },
                      "connected": {
                        "type": "boolean"
                      },
                      "battery": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "signal": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4
                      }
                    },
                    "required": [
                      "address",
                      "name",
                      "kind",
                      "connected"
                    ]
                  }
                }
              },
              "required": [
                "until",
                "devices"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "pairing": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^p-[a-z0-9]{8,32}$"
                },
                "address": {
                  "type": "string",
                  "pattern": "^[0-9A-F]{2}(:[0-9A-F]{2}){5}$"
                },
                "name": {
                  "type": "string",
                  "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,80}$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "keyboard",
                    "mouse",
                    "headphones",
                    "headset",
                    "speaker",
                    "gamepad",
                    "other"
                  ]
                },
                "phase": {
                  "type": "string",
                  "enum": [
                    "pairing",
                    "code",
                    "confirm",
                    "connecting",
                    "done",
                    "failed"
                  ]
                },
                "deadline": {
                  "type": "string",
                  "maxLength": 40,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                "code": {
                  "type": "string",
                  "pattern": "^[0-9]{4,6}$"
                },
                "typed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "failure": {
                  "type": "string",
                  "enum": [
                    "rejected",
                    "timeout",
                    "not_found",
                    "canceled",
                    "failed"
                  ]
                }
              },
              "required": [
                "id",
                "address",
                "name",
                "kind",
                "phase",
                "deadline"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "adapter",
        "devices",
        "scan",
        "pairing"
      ]
    }
  },
  "required": [
    "v",
    "bluetooth"
  ]
}
