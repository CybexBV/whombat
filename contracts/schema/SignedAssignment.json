{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/SignedAssignment.json",
  "title": "SignedAssignment",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string",
          "const": "whombat-update-assignment/v1"
        },
        "env": {
          "type": "string",
          "enum": [
            "local",
            "dev",
            "prod"
          ]
        },
        "device": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "action": {
          "type": "string",
          "enum": [
            "install",
            "hold"
          ]
        },
        "releaseId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 3,
              "maxLength": 80,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tupleDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "rolloutId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cohort": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        },
        "notBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        }
      },
      "required": [
        "purpose",
        "env",
        "device",
        "sequence",
        "action",
        "releaseId",
        "tupleDigest",
        "rolloutId",
        "cohort",
        "issuedAt",
        "notBefore",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "sig": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "required": [
    "payload",
    "keyId",
    "sig"
  ],
  "additionalProperties": false
}
