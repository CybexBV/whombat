{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/HealthEvidence.json",
  "title": "HealthEvidence",
  "type": "object",
  "properties": {
    "check": {
      "type": "string",
      "enum": [
        "runtime",
        "database",
        "session_endpoint",
        "runner",
        "relay_control",
        "boot",
        "manager"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "check",
    "ok",
    "at"
  ],
  "additionalProperties": false
}
