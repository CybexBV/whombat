{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/StatusReportRequest.json",
  "title": "StatusReportRequest",
  "type": "object",
  "properties": {
    "release": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "managerVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]*$"
    },
    "runtimeVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]*$"
    },
    "uptimeS": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3153600000
    },
    "update": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "Assigned",
            "Downloading",
            "Verified",
            "Staged",
            "WaitingForSafeBoundary",
            "Activating",
            "Verifying",
            "Healthy",
            "Failed",
            "RolledBack",
            "Quarantined",
            "ForwardRepairRequired"
          ]
        },
        "candidate": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 3,
              "maxLength": 80,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "failure": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "failureDetail": {
          "type": "object",
          "properties": {
            "stage": {
              "type": "string",
              "enum": [
                "Assigned",
                "Downloading",
                "Verified",
                "Staged",
                "WaitingForSafeBoundary",
                "Activating",
                "Verifying",
                "Healthy",
                "Failed",
                "RolledBack",
                "Quarantined",
                "ForwardRepairRequired"
              ]
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "reasons": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "release": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "schema": {
              "type": "object",
              "properties": {
                "database": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "target": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "candidateWrites": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "candidateReads": {
                  "type": "object",
                  "properties": {
                    "min": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "max": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    }
                  },
                  "required": [
                    "min",
                    "max"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "database",
                "target",
                "candidateWrites",
                "candidateReads"
              ]
            },
            "rollbackAccess": {
              "type": "string",
              "enum": [
                "read-write",
                "read-only",
                "none"
              ]
            },
            "failedChecks": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "runtime",
                  "database",
                  "session_endpoint",
                  "runner",
                  "relay_control",
                  "boot",
                  "manager"
                ]
              }
            },
            "at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4102444800
            }
          },
          "required": [
            "stage",
            "code",
            "reasons",
            "release",
            "failedChecks",
            "at"
          ],
          "additionalProperties": false
        },
        "waiting": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "enum": [
                "boundary",
                "checkpoint",
                "window",
                "hold",
                "lock",
                "metadata",
                "owner"
              ]
            },
            "since": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4102444800
            }
          },
          "required": [
            "reason",
            "since"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "state",
        "candidate",
        "attempt",
        "failure"
      ],
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "down"
          ]
        },
        "database": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "down"
          ]
        },
        "runner": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "down"
          ]
        },
        "sessionEndpoint": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "down"
          ]
        },
        "relay": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "down"
          ]
        },
        "backup": {
          "type": "string",
          "enum": [
            "ok",
            "stale",
            "failing",
            "unconfigured"
          ]
        }
      },
      "required": [
        "runtime",
        "database",
        "runner",
        "sessionEndpoint",
        "relay",
        "backup"
      ],
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "persistUsedPct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "persistFreeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "persistUsedPct",
        "persistFreeBytes"
      ],
      "additionalProperties": false
    },
    "sessionsActive": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "recoveryKit": {
      "type": "string",
      "enum": [
        "not_created",
        "unconfirmed",
        "confirmed"
      ]
    },
    "lastBackupAt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        },
        {
          "type": "null"
        }
      ]
    },
    "clockSynced": {
      "type": "boolean"
    },
    "support": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "off",
            "look",
            "fix"
          ]
        },
        "untilS": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 604800
            },
            {
              "type": "null"
            }
          ]
        },
        "connected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "helpCode": {
          "type": "boolean"
        },
        "hostKey": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI[A-Za-z0-9+/]{43}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "untilS",
        "connected",
        "helpCode",
        "hostKey"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "release",
    "managerVersion",
    "uptimeS",
    "update",
    "health",
    "storage",
    "sessionsActive",
    "recoveryKit",
    "lastBackupAt",
    "clockSynced"
  ],
  "additionalProperties": false
}
