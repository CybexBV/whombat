{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/RuntimeFacts.json",
  "title": "RuntimeFacts",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "activeSessions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "claimed": {
      "type": "boolean"
    },
    "claimReported": {
      "type": "boolean"
    },
    "recovery": {
      "type": "object",
      "properties": {
        "enrolled": {
          "type": "boolean"
        },
        "kitVerified": {
          "type": "boolean"
        }
      },
      "required": [
        "enrolled",
        "kitVerified"
      ]
    },
    "revocations": {
      "type": "object",
      "properties": {
        "pending": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "applied": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "pending",
        "applied"
      ]
    },
    "draining": {
      "type": "boolean"
    },
    "quarantined": {
      "type": "boolean"
    },
    "relay": {
      "type": "string",
      "enum": [
        "stopped",
        "connecting",
        "connected",
        "backoff"
      ]
    },
    "clientAdapters": {
      "type": "object",
      "properties": {
        "claude": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "claude"
      ]
    }
  },
  "required": [
    "v",
    "activeSessions",
    "claimed",
    "claimReported",
    "recovery",
    "revocations",
    "draining",
    "quarantined",
    "relay",
    "clientAdapters"
  ]
}
