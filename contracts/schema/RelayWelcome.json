{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/RelayWelcome.json",
  "title": "RelayWelcome",
  "type": "object",
  "properties": {
    "t": {
      "type": "string",
      "const": "welcome"
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "conn": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "heartbeatMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 120000
    },
    "maxMessage": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 16777216
    },
    "lease": {
      "type": "object",
      "properties": {
        "renewWithinS": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      },
      "required": [
        "renewWithinS"
      ]
    }
  },
  "required": [
    "t",
    "v",
    "conn",
    "heartbeatMs",
    "maxMessage"
  ]
}
