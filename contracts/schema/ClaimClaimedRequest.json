{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/ClaimClaimedRequest.json",
  "title": "ClaimClaimedRequest",
  "type": "object",
  "properties": {
    "claimId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "claimedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    }
  },
  "required": [
    "claimId",
    "claimedAt"
  ],
  "additionalProperties": false
}
