{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/DirectDownstreamMessage.json",
  "title": "DirectDownstreamMessage",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "welcome"
        },
        "v": {
          "type": "number",
          "const": 1
        },
        "heartbeatMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "maxMessage": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        }
      },
      "required": [
        "t",
        "v",
        "heartbeatMs",
        "maxMessage"
      ]
    }
  ]
}
