{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/CableSetRequest.json",
  "title": "CableSetRequest",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "use": {
      "type": "string",
      "enum": [
        "wifi",
        "cable"
      ]
    },
    "confirmTimeoutSec": {
      "type": "integer",
      "minimum": 30,
      "maximum": 600
    }
  },
  "required": [
    "v",
    "use",
    "confirmTimeoutSec"
  ],
  "additionalProperties": false
}
