{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/RuntimeHealth.json",
  "title": "RuntimeHealth",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "degraded",
        "starting"
      ]
    },
    "releaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "checks": {
      "type": "object",
      "properties": {
        "db": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "detail": {
              "type": "string",
              "minLength": 0,
              "maxLength": 500,
              "pattern": "^[\\x20-\\x7e]*$"
            }
          },
          "required": [
            "ok"
          ]
        },
        "migrations": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "compatible": {
              "type": "boolean"
            },
            "access": {
              "type": "string",
              "enum": [
                "read-write",
                "read-only",
                "none"
              ]
            },
            "verdict": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "schemaVersion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "detail": {
              "type": "string",
              "minLength": 0,
              "maxLength": 500,
              "pattern": "^[\\x20-\\x7e]*$"
            }
          },
          "required": [
            "ok",
            "compatible",
            "access",
            "schemaVersion"
          ]
        },
        "sessionEndpoint": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "detail": {
              "type": "string",
              "minLength": 0,
              "maxLength": 500,
              "pattern": "^[\\x20-\\x7e]*$"
            }
          },
          "required": [
            "ok"
          ]
        },
        "maintenance": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "detail": {
              "type": "string",
              "minLength": 0,
              "maxLength": 500,
              "pattern": "^[\\x20-\\x7e]*$"
            }
          },
          "required": [
            "ok"
          ]
        }
      },
      "required": [
        "db",
        "migrations",
        "sessionEndpoint"
      ]
    },
    "external": {
      "type": "object",
      "properties": {
        "relay": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "down",
            "unknown"
          ]
        },
        "control": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "down",
            "unknown"
          ]
        },
        "providers": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "down",
            "unknown"
          ]
        }
      }
    },
    "draining": {
      "type": "boolean"
    }
  },
  "required": [
    "v",
    "status",
    "releaseId",
    "version",
    "checks",
    "draining"
  ]
}
