{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/LicenceLimits.json",
  "title": "LicenceLimits",
  "type": "object",
  "properties": {
    "devices": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "connectors": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "devices",
    "connectors"
  ],
  "additionalProperties": false
}
