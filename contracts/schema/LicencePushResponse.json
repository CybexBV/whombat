{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/LicencePushResponse.json",
  "title": "LicencePushResponse",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "licence": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "licensed",
                "grace",
                "lapsed"
              ]
            },
            "reason": {
              "type": "string",
              "enum": [
                "active",
                "trial",
                "past_due",
                "payment",
                "not_renewed",
                "no_licence",
                "cancelled",
                "expired"
              ]
            },
            "plan": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{1,32}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "expiresAt": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 40,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "graceEndsAt": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 40,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "effectiveAt": {
              "type": "string",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          },
          "required": [
            "state",
            "reason",
            "plan",
            "expiresAt",
            "graceEndsAt",
            "effectiveAt"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "v",
    "licence"
  ]
}
