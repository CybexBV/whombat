{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/LocalError.json",
  "title": "LocalError",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "message": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500,
          "pattern": "^[\\x20-\\x7e]*$"
        },
        "stage": {
          "type": "string",
          "enum": [
            "preflight",
            "quiesce",
            "snapshot",
            "dump",
            "upload",
            "verify"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  },
  "required": [
    "error"
  ]
}
