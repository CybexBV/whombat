{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/NetworkStatus.json",
  "title": "NetworkStatus",
  "type": "object",
  "properties": {
    "candidateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "applying",
        "confirming",
        "committed",
        "reverting",
        "reverted"
      ]
    },
    "deadline": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "result": {
      "type": "string",
      "minLength": 0,
      "maxLength": 300,
      "pattern": "^[\\x20-\\x7e]*$"
    },
    "updatedAt": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "required": [
    "updatedAt"
  ]
}
