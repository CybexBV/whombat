{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/TailscalePeersResponse.json",
  "title": "TailscalePeersResponse",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "peers": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 3,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?([.][a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "addresses": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f:.]{2,45}$"
            }
          },
          "os": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,32}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "online": {
            "type": "boolean"
          },
          "lastSeen": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40,
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "routes": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f:.]{2,45}[/][0-9]{1,3}$"
            }
          },
          "exitNode": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "addresses",
          "os",
          "online",
          "lastSeen",
          "routes",
          "exitNode"
        ]
      }
    }
  },
  "required": [
    "v",
    "peers"
  ]
}
