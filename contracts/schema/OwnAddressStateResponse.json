{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/OwnAddressStateResponse.json",
  "title": "OwnAddressStateResponse",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "label": {
      "type": "string",
      "minLength": 11,
      "maxLength": 32,
      "pattern": "^[a-z]{3,10}-[a-z]{3,10}-[a-z]{3,10}$"
    },
    "host": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z]{3,10}-[a-z]{3,10}-[a-z]{3,10}[.](box|dev)[.]whombat[.]app$"
    },
    "acme": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "idle",
            "probing",
            "ordering",
            "valid",
            "failing"
          ]
        },
        "error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "nextAttemptAt": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "required": [
        "state"
      ]
    },
    "cert": {
      "type": "object",
      "properties": {
        "serial": {
          "type": "string",
          "pattern": "^[0-9a-f]{2,64}$"
        },
        "spkiSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "notBefore": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "notAfter": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "required": [
        "serial",
        "spkiSha256",
        "notBefore",
        "notAfter"
      ]
    }
  },
  "required": [
    "v",
    "enabled",
    "acme"
  ]
}
