{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/VoiceTtsRequest.json",
  "title": "VoiceTtsRequest",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "text": {
      "type": "string",
      "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,600}$"
    },
    "voice": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "nl"
      ]
    }
  },
  "required": [
    "v",
    "text"
  ],
  "additionalProperties": false
}
