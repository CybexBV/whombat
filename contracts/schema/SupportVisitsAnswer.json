{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/SupportVisitsAnswer.json",
  "title": "SupportVisitsAnswer",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "visits": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "who": {
            "type": "string",
            "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,40}$"
          },
          "level": {
            "type": "string",
            "enum": [
              "look",
              "fix"
            ]
          },
          "startedAt": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "endedAt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40,
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "steps": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "maxLength": 40,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "connected",
                    "left",
                    "look",
                    "exec",
                    "shell",
                    "restart",
                    "forward",
                    "refused",
                    "wrong_code"
                  ]
                },
                "command": {
                  "type": "string",
                  "enum": [
                    "help",
                    "status",
                    "units",
                    "logs",
                    "boots",
                    "hardware",
                    "network",
                    "disks",
                    "memory",
                    "processes",
                    "updates",
                    "report"
                  ]
                },
                "units": {
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9@._-]{1,80}$"
                  }
                },
                "line": {
                  "type": "string",
                  "pattern": "^(?:[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Z}]| ){1,500}$"
                },
                "seconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 315360000
                },
                "target": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[\\x20-\\x7e]*$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "level",
                    "code",
                    "certificate",
                    "limit",
                    "unknown_command",
                    "bad_arguments"
                  ]
                }
              },
              "required": [
                "at",
                "kind"
              ]
            }
          },
          "truncated": {
            "type": "boolean"
          },
          "transcriptBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 52428800
          }
        },
        "required": [
          "id",
          "who",
          "level",
          "startedAt",
          "endedAt",
          "steps",
          "truncated",
          "transcriptBytes"
        ]
      }
    }
  },
  "required": [
    "v",
    "visits"
  ]
}
