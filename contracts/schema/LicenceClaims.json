{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whombat.com/contracts/LicenceClaims.json",
  "title": "LicenceClaims",
  "type": "object",
  "properties": {
    "iss": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256,
      "pattern": "^https?:\\/\\/[\\x21-\\x7e]+$"
    },
    "aud": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^whombat-appliance:[a-z0-9-]{1,32}$"
    },
    "sub": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "org": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "plan": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "trialing",
        "active",
        "past_due",
        "grace",
        "cancelled"
      ]
    },
    "limits": {
      "type": "object",
      "properties": {
        "devices": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "connectors": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "devices",
        "connectors"
      ],
      "additionalProperties": false
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "nbf": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "jti": {
      "type": "string",
      "minLength": 22,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "iss",
    "aud",
    "sub",
    "org",
    "plan",
    "state",
    "limits",
    "iat",
    "nbf",
    "exp",
    "jti"
  ],
  "additionalProperties": false
}
