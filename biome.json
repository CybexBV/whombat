{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!docs/design-handoff",
      "!packages/brand/assets",
      "!packages/avatars/svg",
      "!packages/hermes-whombat/vendor",
      "!**/migrations/meta",
      "!contracts/schema",
      "!contracts/vectors",
      "!contracts/go",
      "!pnpm-lock.yaml",
      "!appliance",
      "!hosts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "cssModules": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useValidAriaRole": {
          "level": "error",
          "options": {
            "ignoreNonDom": true
          }
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/web/**",
        "apps/mobile/**",
        "apps/widget/**",
        "packages/client/**",
        "packages/avatars/**",
        "packages/brand/**",
        "packages/tokens/**",
        "tools/**"
      ],
      "linter": {
        "domains": {
          "react": "recommended"
        },
        "rules": {
          "style": {
            "noDescendingSpecificity": "info"
          }
        }
      }
    }
  ]
}
