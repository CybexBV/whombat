node_modules/
dist/
build/
coverage/
.env
.env.local
*.log
.DS_Store
.claude/worktrees/
playwright-report/
test-results/
storybook-static/
apps/mobile/android/
apps/mobile/ios/
apps/mobile/.expo/
*.tsbuildinfo
tmp/
.visual/
.env.*
!.env.example

# Release artifacts (`pnpm contracts:release`, `pnpm app:release`) and the hosted builds.
dist-release/
dist-hosted/
dist-hosted-e2e/
dist-managed-e2e/

# A local Go workspace, for trying one module against another: each module builds by itself and none is committed.
go.work
go.work.sum

# Python helpers for local CI infrastructure.
__pycache__/
*.pyc
ci-reports/
http_cache.sqlite
.worktrees/

# appliance/ and hosts/ track files in folders the rules above ignore everywhere else: a Go package called coverage,
# the signed Whombat Helper for macOS, and test data that copies a server's own folders (tmp/, *.log).
!appliance/backup/pkg/coverage/
!hosts/macos/helper/dist/
!hosts/**/testdata/**
