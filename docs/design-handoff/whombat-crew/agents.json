{
  "replaces": "docs/design-handoff/five-agents (2026-10-02): same five roles, keys, role labels, accents, file names and size rule; new art and three new names",
  "sizeRule": {
    "bust": ">= 40px",
    "head": "25-39px",
    "headSmall": "<= 24px"
  },
  "agents": [
    {
      "key": "associate",
      "defaultName": "Dusty",
      "previousName": "Pippa",
      "roleLabel": "Associate",
      "renamable": false,
      "accent": "#8f7fc9",
      "accentDeep": "#6a5aa3",
      "look": "chestnut fur, round reading glasses, freckles, slightly taller head; curious, one brow up",
      "svg": {
        "bust": "svg/associate-bust.svg",
        "head": "svg/associate-head.svg",
        "headSmall": "svg/associate-head-small.svg"
      },
      "png": [
        "png/associate-bust-512.png",
        "png/associate-bust-256.png",
        "png/associate-head-256.png",
        "png/associate-head-small-64.png"
      ]
    },
    {
      "key": "developer",
      "defaultName": "Banjo",
      "previousName": "Banjo",
      "roleLabel": "Software Developer",
      "renamable": false,
      "accent": "#5aa37a",
      "accentDeep": "#3e7b58",
      "look": "silver fur, thick square glasses taped at the bridge, pens in the shirt pocket, small tuft on top, little “w” smile",
      "svg": {
        "bust": "svg/developer-bust.svg",
        "head": "svg/developer-head.svg",
        "headSmall": "svg/developer-head-small.svg"
      },
      "png": [
        "png/developer-bust-512.png",
        "png/developer-bust-256.png",
        "png/developer-head-256.png",
        "png/developer-head-small-64.png"
      ]
    },
    {
      "key": "operator",
      "defaultName": "Neo",
      "previousName": "Dusty",
      "roleLabel": "Operator",
      "renamable": false,
      "accent": "#b99346",
      "accentDeep": "#8d6d2d",
      "look": "dark slate fur, wide flat head with small ears, small tuft on top, black suit with a gold tie and gold pocket square, slim oval dark sunglasses; calm",
      "svg": {
        "bust": "svg/operator-bust.svg",
        "head": "svg/operator-head.svg",
        "headSmall": "svg/operator-head-small.svg"
      },
      "png": [
        "png/operator-bust-512.png",
        "png/operator-bust-256.png",
        "png/operator-head-256.png",
        "png/operator-head-small-64.png"
      ]
    },
    {
      "key": "lead",
      "defaultName": "Skipper",
      "previousName": "Ace",
      "roleLabel": "Lead",
      "renamable": false,
      "accent": "#c65d6e",
      "accentDeep": "#a33346",
      "look": "honey fur, cowlick, a wink and a grin, gold rosette on the shirt",
      "svg": {
        "bust": "svg/lead-bust.svg",
        "head": "svg/lead-head.svg",
        "headSmall": "svg/lead-head-small.svg"
      },
      "png": [
        "png/lead-bust-512.png",
        "png/lead-bust-256.png",
        "png/lead-head-256.png",
        "png/lead-head-small-64.png"
      ]
    },
    {
      "key": "assistant",
      "defaultName": "Hazel",
      "previousName": "Hazel",
      "roleLabel": "Assistant",
      "renamable": true,
      "accent": "#a6ad43",
      "accentDeep": "#74792a",
      "look": "cocoa fur, warm eager grin, clipboard on the shirt",
      "svg": {
        "bust": "svg/assistant-bust.svg",
        "head": "svg/assistant-head.svg",
        "headSmall": "svg/assistant-head-small.svg"
      },
      "png": [
        "png/assistant-bust-512.png",
        "png/assistant-bust-256.png",
        "png/assistant-head-256.png",
        "png/assistant-head-small-64.png"
      ]
    }
  ],
  "expressions": {
    "note": "Delivered for later use; not wired in this change. Same 512x512 bust framing as <key>-bust.svg, so one can replace the other in place. Neutral is each character's own default face.",
    "names": ["neutral", "happy", "listening", "thinking", "working", "surprised", "confused", "apologetic", "sleepy", "celebrate"],
    "path": "expressions/svg/<key>-<expression>.svg"
  }
}
