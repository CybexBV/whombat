@@ -795,6 +795,29 @@ static NSLineBreakMode RCTNSLineBreakModeFromEllipsizeMode(RNUITextViewEllipsize
 
 // MARK: - UITextViewDelegate
 
+// [whombat patch] Select All in the menu of selected words: iOS leaves it out for text that can't be edited. A tap on
+// the selection then shows the menu again, with Copy.
+- (UIMenu *)textView:(UITextView *)textView
+    editMenuForTextInRange:(NSRange)range
+          suggestedActions:(NSArray<UIMenuElement *> *)suggestedActions API_AVAILABLE(ios(16.0))
+{
+  const NSUInteger length = textView.attributedText.length;
+  if (range.length >= length) {
+    return [UIMenu menuWithChildren:suggestedActions];
+  }
+  __weak UITextView *weakTextView = textView;
+  UIAction *selectAll = [UIAction actionWithTitle:@"Select All"
+                                            image:[UIImage systemImageNamed:@"selection.pin.in.out"]
+                                       identifier:nil
+                                          handler:^(__kindof UIAction *action) {
+                                            UITextView *view = weakTextView;
+                                            view.selectedRange = NSMakeRange(0, view.attributedText.length);
+                                          }];
+  NSMutableArray<UIMenuElement *> *children = [suggestedActions mutableCopy];
+  [children insertObject:selectAll atIndex:MIN((NSUInteger)1, children.count)];
+  return [UIMenu menuWithChildren:children];
+}
