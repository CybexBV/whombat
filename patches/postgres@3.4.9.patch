--- a/cjs/src/connection.js
+++ b/cjs/src/connection.js
@@ -252,6 +252,15 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
   }
 
   function nextWrite(fn) {
+    // [whombat patch] closed() has nulled the socket (the server ended the session) and nothing reconnected it
+    // yet. Throwing here from setImmediate is an uncaughtException that exits the process; settle the pending
+    // queries with a catchable CONNECTION_CLOSED instead (porsager/postgres#1208, #1154, #1066; PR #1209).
+    if (!socket) {
+      nextWriteTimer !== null && clearImmediate(nextWriteTimer)
+      chunk = nextWriteTimer = null
+      error(Errors.connection('CONNECTION_CLOSED', options, socket))
+      return false
+    }
     const x = socket.write(chunk, fn)
     nextWriteTimer !== null && clearImmediate(nextWriteTimer)
     chunk = nextWriteTimer = null
@@ -425,6 +434,9 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
       error(Errors.connection('CONNECTION_DESTROYED', options))
 
     clearImmediate(nextWriteTimer)
+    // [whombat patch] Drop the unsent bytes and the spent timer handle: a non-null nextWriteTimer stops write()
+    // from ever scheduling a flush again, so the next socket's StartupMessage would never be sent (PR #1215).
+    chunk = nextWriteTimer = null
     if (socket) {
       socket.removeListener('data', data)
       socket.removeListener('connect', connected)
@@ -438,6 +450,9 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     remaining = 0
     incomings = null
     clearImmediate(nextWriteTimer)
+    // [whombat patch] As in terminate(): bytes meant for the dead session must not reach the next socket
+    // (ahead of its StartupMessage), and a spent timer handle must not block its writes (PR #1215).
+    chunk = nextWriteTimer = null
     socket.removeListener('data', data)
     socket.removeListener('connect', connected)
     idleTimer.cancel()
@@ -451,6 +466,12 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
       return reconnect()
 
     !hadError && (query || sent.length) && error(Errors.connection('CONNECTION_CLOSED', options, socket))
+    // [whombat patch] The dead session's query is settled now (above, or by the socket's 'error'). Forget it and
+    // its pending ErrorResponse and partial result: otherwise the next session's first ReadyForQuery replays
+    // the old backend's error (e.g. 57P01) onto the query that reconnected it (PRs #1215, #1229).
+    query = results = errorResponse = null
+    result = new Result()
+    rows = 0
     closedTime = performance.now()
     hadError && options.shared.retries++
     delay = (typeof backoff === 'function' ? backoff(options.shared.retries) : backoff) * 1000
@@ -561,7 +582,11 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
 
       if (needsTypes) {
         initial.reserve && (initial = null)
-        return fetchArrayTypes()
+        // [whombat patch] Nothing awaits this promise. When the fetch fails (e.g. the session is lost), errored()
+        // hands the error to the waiting query (`initial`; a reserve() waiter stays queued in the pool); the
+        // internal query's own rejection would be an unhandledRejection that exits the process
+        // (porsager/postgres#1223; PR #1241).
+        return fetchArrayTypes().catch(noop)
       }
 
       initial && !initial.reserve && execute(initial)
